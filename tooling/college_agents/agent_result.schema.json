{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rajasthan college official-site verification result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "institution_id",
    "nirf_name",
    "verification_outcome",
    "district",
    "district_verification_status",
    "official_website",
    "website_verification_status",
    "description",
    "description_verification_status",
    "record_status",
    "allowed_official_domains",
    "verification_sources",
    "website_search_evidence",
    "course_catalogue_status",
    "courses",
    "agent_notes"
  ],
  "properties": {
    "institution_id": {"type": "string", "minLength": 1},
    "nirf_name": {"type": "string", "minLength": 1},
    "verification_outcome": {
      "enum": ["verified", "remove_candidate", "manual_review"]
    },
    "district": {"type": ["string", "null"]},
    "district_verification_status": {
      "enum": [
        "verified_official_website",
        "pending_official_source",
        "not_found"
      ]
    },
    "official_website": {
      "type": ["string", "null"]
    },
    "website_verification_status": {
      "enum": ["verified", "not_found", "ambiguous"]
    },
    "description": {"type": ["string", "null"]},
    "description_verification_status": {
      "enum": ["verified_official_website", "pending", "not_found"]
    },
    "record_status": {
      "enum": ["verified", "remove_candidate", "manual_review"]
    },
    "allowed_official_domains": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "verification_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "website_search_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/searchEvidence"}
    },
    "course_catalogue_status": {
      "enum": [
        "verified_official_website",
        "partial_official_website",
        "not_found"
      ]
    },
    "courses": {
      "type": "array",
      "items": {"$ref": "#/$defs/course"}
    },
    "agent_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "supports"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "searchEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "result", "url"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "url": {"type": ["string", "null"]}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "career_node_id",
        "career_node_slug",
        "career_breadcrumb",
        "relation",
        "confidence",
        "mapping_status"
      ],
      "properties": {
        "career_node_id": {"type": "integer", "minimum": 1},
        "career_node_slug": {"type": "string", "minLength": 1},
        "career_breadcrumb": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "mapping_status": {
          "enum": [
            "reviewed_against_local_tree",
            "reviewed_with_career_tree_label_issue"
          ]
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "course_id",
        "name",
        "level",
        "credential",
        "specialization",
        "duration",
        "mode",
        "eligibility",
        "official_course_url",
        "verification_status",
        "career_path_mappings",
        "mapping_gap"
      ],
      "properties": {
        "course_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "level": {"type": "string", "minLength": 1},
        "credential": {"type": "string", "minLength": 1},
        "specialization": {"type": ["string", "null"]},
        "duration": {"type": ["string", "null"]},
        "mode": {"type": "string", "minLength": 1},
        "eligibility": {"type": ["string", "null"]},
        "official_course_url": {"type": "string", "minLength": 1},
        "verification_status": {
          "enum": ["verified", "verified_programme_family"]
        },
        "career_path_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/mapping"}
        },
        "mapping_gap": {"type": ["string", "null"]}
      }
    }
  }
}
