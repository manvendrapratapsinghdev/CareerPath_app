{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc 'site_dir=$(find \"$TMPDIR\" -maxdepth 1 -type d -name '\"'alot-site-pages.*' -print | tail -n 1)\nfor page in regular_courses distance_courses glance how_to_reach contact departments; do\n  printf '%s\\\\n' \\\"--- \"'$page tables/headings ---\"\n  python3 - \"$site_dir/$page.html\" <<'\"'PY'\nfrom html.parser import HTMLParser\nimport html,sys\nclass P(HTMLParser):\n def __init__(self): super().__init__(); self.stack=[]; self.row=None; self.cell=None; self.rows=[]; self.head=[]\n def handle_starttag(self,t,a):\n  if t=='tr': self.row=[]\n  elif t in ('th','td') and self.row is not None: self.cell=[]\n  self.stack.append(t)\n def handle_data(self,d):\n  if self.cell is not None:self.cell.append(d)\n def handle_endtag(self,t):\n  if t in ('th','td') and self.cell is not None:\n   self.row.append(' '.join(''.join(self.cell).split()));self.cell=None\n  if t=='tr' and self.row is not None:\n   if any(self.row): self.rows.append(self.row)\n   self.row=None\n  if self.stack:\n   try:self.stack.pop()\n   except:pass\np=P();p.feed(open(sys.argv[1],errors='ignore').read())\nfor r in p.rows:\n print(' | '.join(r))\nPY\ndone\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
