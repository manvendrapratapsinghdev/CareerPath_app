{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'set +e\nsearch2=$(mktemp -d \"${TMPDIR:-/tmp}/alot-search2.XXXXXX\")\nqueries=(\n  '\"'Govt College Alot Madhya Pradesh official website'\n  '\\\"Govt. College, Alot\\\"'\n  '\\\"Government College Alot\\\" Ratlam'\n)\nfor engine in yahoo startpage qwant; do\n  i=0\n  for q in \\\"\"'${queries[@]}\"; do\n    i=$((i+1)); out=\"$search2/${engine}_$i.html\"\n    case \"$engine\" in\n      yahoo) url='\"'https://search.yahoo.com/search';;\n      startpage) url='https://www.startpage.com/sp/search';;\n      qwant) url='https://www.qwant.com/';;\n    esac\n    printf '%s\\\\n' \\\"--- \"'$engine $i: $q ---\"\n    curl -L --insecure --fail --silent --show-error --max-time 45 -A '\"'Mozilla/5.0' -G \\\"\"'$url\" --data-urlencode \"p=$q\" --data-urlencode \"query=$q\" --data-urlencode \"q=$q\" -o \"$out\"\n    rc=$?; printf '\"'rc=%s bytes=' \\\"\"'$rc\"; test -f \"$out\" && wc -c < \"$out\" || printf '\"'0\\\\n'\n    if test \\\"\"'$rc\" -eq 0; then\n      python3 - \"$out\" <<'\"'PY'\nimport html,re,sys\ns=open(sys.argv[1],errors='ignore').read();\nfor pat in [r'<a[\"'^>]+href=[\"'\"\\\\']([\"'^\"'\"\\\\']+)[\\\"\\\\'][\"'^>]*>(.*?)</a>'\"',r'\\\"url\\\":\\\"(https?[\"'^\" ]+)\"'\"']:\n for m in re.finditer(pat,s,re.S|re.I):\n  u=html.unescape(m.group(1)); t=' '.join(re.sub('<[\"'^>]+>'\"',' ',m.group(2)).split()) if len(m.groups())>1 else ''\n  if u.startswith('http') and not any(x in u for x in ['yahoo.com','startpage.com','qwant.com','google.com']): print('RESULT',t[:160],'|',u[:350])\nPY\n    fi\n  done\ndone\nprintf 'search2=%s\\\\n' \\\"\"'$search2\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
