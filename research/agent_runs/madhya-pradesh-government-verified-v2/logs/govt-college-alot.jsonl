{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'set +e\nsearch_dir=$(find \"$TMPDIR\" -maxdepth 1 -type d -name '\"'alot-search.*' -print | tail -n 1)\nq='\\\"Govt. College, Alot\\\"'\nfor name_url in \\\\\n  'google_in|https://www.google.co.in/search' \\\\\n  'google_uk|https://www.google.co.uk/search' \\\\\n  'google_com_gbv|https://www.google.com/search'; do\n  name=\"'${name_url%%|*}; url=${name_url#*|}\n  printf '\"'%s\\\\n' \\\"--- \"'$name ---\"\n  curl -L --insecure --fail --silent --show-error --max-time 45 -A '\"'Mozilla/5.0' -G \\\"\"'$url\" --data-urlencode \"q=$q\" --data-urlencode '\"'num=10' --data-urlencode 'gbv=1' -o \\\"\"'$search_dir/$name.html\"\n  rc=$?; printf '\"'rc=%s bytes=' \\\"\"'$rc\"; test -f \"$search_dir/$name.html\" && wc -c < \"$search_dir/$name.html\" || printf '\"'0\\\\n'\n  if test \\\"\"'$rc\" -eq 0; then\n    python3 - \"$search_dir/$name.html\" <<'\"'PY'\nimport html, re, sys\ns=open(sys.argv[1],errors='ignore').read()\nprint('title=', re.sub('<[\"'^>]+>'\"',' ', re.search(r'<title[\"'^>]*>(.*?)</title>'\"',s,re.S|re.I).group(1)).strip() if re.search(r'<title[\"'^>]*>(.*?)</title>'\"',s,re.S|re.I) else '')\nfor m in re.finditer(r'<a[\"'^>]+href=\"(https?://[''^\"&]+)\"[''^>]*>(.*?)</a>'\"', s, re.S|re.I):\n    u=html.unescape(m.group(1)); t=' '.join(re.sub('<[\"'^>]+>'\"',' ',m.group(2)).split())\n    if t and not any(x in u for x in ['google.com','gstatic.com']): print('RESULT',t[:180],'|',u[:300])\nPY\n  fi\ndone\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
