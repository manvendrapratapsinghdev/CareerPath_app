{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc 'search_dir=$(find \"$TMPDIR\" -maxdepth 1 -type d -name '\"'alot-search.*' -print | tail -n 1)\npython3 - \\\"\"'$search_dir\" <<'\"'PY'\nimport html, pathlib, re, sys, urllib.parse, base64\nroot=pathlib.Path(sys.argv[1])\nfor p in sorted(root.glob('bing_*.html')):\n    s=p.read_text(errors='ignore')\n    print('\\\\n###',p.name)\n    for block in re.findall(r'<li class=\\\"b_algo\\\".*?</li>',s,re.S|re.I):\n        h=re.search(r'<h2[\"'^>]*>'\"\\\\s*<a[\"'^>]*href=\"([''^\"]+)\"[''^>]*>(.*?)</a>'\"',block,re.S|re.I)\n        if not h: continue\n        u=html.unescape(h.group(1)); title=re.sub('<[\"'^>]+>'\"','',h.group(2)); title=' '.join(html.unescape(title).split())\n        m=re.search(r'[?&]u=a1([\"'^&\"]+)'\"',u)\n        if m:\n            try: real=base64.urlsafe_b64decode(m.group(1)+'===').decode('utf-8','ignore')\n            except Exception: real=u\n        else: real=u\n        cap=re.search(r'<p[\"'^>]*>(.*?)</p>'\"',block,re.S|re.I)\n        caption=' '.join(re.sub('<[\"'^>]+>'\"','',cap.group(1)).split()) if cap else ''\n        print('TITLE:',title)\n        print('URL:',real)\n        print('CAP:',html.unescape(caption)[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
