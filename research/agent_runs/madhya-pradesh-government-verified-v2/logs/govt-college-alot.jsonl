{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'set +e\nprobe_dir=$(mktemp -d \"${TMPDIR:-/tmp}/alot-college-profile.XXXXXX\")\nfor url in '\"'https://highereducation.mp.gov.in/ClgProfile' 'https://highereducation.mp.gov.in/?page=3ReniKuyIMmDd4opO%2FkIdA%3D%3D' 'https://hed.mponline.gov.in/'; do\n  name=\"'$(printf '\"'%s' \\\"\"'$url\" | sed -E '\"'s#https?://([\"'^/]+).*#'\"\\\\1#; s/[\"'^A-Za-z0-9]/_/g'\"')_\"'$(printf '\"'%s' \\\"\"'$url\" | cksum | cut -d'\"' ' -f1)\n  printf '%s\\\\n' \\\"--- normal \"'$url ---\"\n  curl -L --fail --silent --show-error --max-time 30 -A '\"'Mozilla/5.0' \\\"\"'$url\" -o \"$probe_dir/$name.normal\" 2>\"$probe_dir/$name.normal.err\"\n  rc=$?; printf '\"'rc=%s bytes=' \\\"\"'$rc\"; test -f \"$probe_dir/$name.normal\" && wc -c < \"$probe_dir/$name.normal\" || printf '\"'0\\\\n'; sed -n '1,3p' \\\"\"'$probe_dir/$name.normal.err\"\n  if test \"$rc\" -eq 60; then\n    printf '\"'%s\\\\n' '--- insecure fallback ---'\n    curl -L --insecure --fail --silent --show-error --max-time 45 -A 'Mozilla/5.0' \\\"\"'$url\" -o \"$probe_dir/$name.html\"\n    printf '\"'bytes='; wc -c < \\\"\"'$probe_dir/$name.html\"\n    python3 - \"$probe_dir/$name.html\" <<'\"'PY'\nimport html,re,sys\ns=open(sys.argv[1],errors='ignore').read(); t=re.search(r'<title[\"'^>]*>(.*?)</title>'\"',s,re.S|re.I)\nprint('TITLE:', ' '.join(re.sub('<[\"'^>]+>'\"',' ',t.group(1)).split()) if t else '')\nprint('TEXTMATCHES:')\nplain=' '.join(re.sub('<[\"'^>]+>'\"',' ',s).split())\nfor k in ['Alot','Alote','College','Ratlam','महावि','आलोट','रतलाम']:\n print(k, len(re.findall(k,plain,re.I)))\nfor m in re.finditer(r'<a[\"'^>]+href=[\"'\"\\\\']([\"'^\"'\"\\\\']+)[\\\"\\\\'][\"'^>]*>(.*?)</a>'\"',s,re.S|re.I):\n u=html.unescape(m.group(1)); x=' '.join(re.sub('<[\"'^>]+>'\"',' ',m.group(2)).split())\n if any(k in (x+' '+u).lower() for k in ['alot','college','clg','profile','course']): print('LINK:',x[:180],'|',u[:300])\nPY\n  fi\ndone\nprintf 'probe_dir=%s\\\\n' \\\"\"'$probe_dir\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
