{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc 'work_tmp=$(find \"${TMPDIR:-/tmp}\" -maxdepth 1 -type d -name '\"'nalkheda.*' | sort | tail -1)\npython3 - \\\"\"'$work_tmp/highereducation.html\" \"$work_tmp/he_College.txt\" <<'\"'PY'\nfrom html.parser import HTMLParser\nfrom urllib.parse import urljoin\nimport sys\nclass P(HTMLParser):\n def __init__(self,base): super().__init__(); self.base=base; self.a=None; self.text=[]\n def handle_starttag(self,t,a):\n  if t=='a': self.a=dict(a).get('href'); self.text=[]\n def handle_data(self,d):\n  if self.a is not None: self.text.append(d)\n def handle_endtag(self,t):\n  if t=='a' and self.a is not None:\n   x=' '.join(' '.join(self.text).split())\n   print(x[:120], '|', urljoin(self.base,self.a))\n   self.a=None\nfor fn in sys.argv[1:]:\n print('###',fn)\n p=P('https://highereducation.mp.gov.in/'); p.feed(open(fn,encoding='utf-8',errors='ignore').read())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
