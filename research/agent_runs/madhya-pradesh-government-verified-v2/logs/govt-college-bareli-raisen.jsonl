te_search_evidence\":[{\"query\":\"Govt College Bareli Raisen official website\",\"result\":\"Bing RSS returned no institution-specific official college result; official-domain discovery proceeded through the Madhya Pradesh Higher Education Department homepage.\",\"url\":\"https://www.bing.com/search?format=rss&q=Govt%20College%20Bareli%20Raisen%20official%20website\"},{\"query\":\"Government College Bareli Raisen Madhya Pradesh official\",\"result\":\"Bing RSS returned no institution-specific official college result; the official Madhya Pradesh Higher Education Department domain was then checked directly.\",\"url\":\"https://www.bing.com/search?format=rss&q=Government%20College%20Bareli%20Raisen%20Madhya%20Pradesh%20official\"},{\"query\":\"gpgcbareli\",\"result\":\"Bing RSS returned unrelated results and no verified official institution website.\",\"url\":\"https://www.bing.com/search?format=rss&q=gpgcbareli\"},{\"query\":\"mphighereducation.nic.in/gpgcbareli\",\"result\":\"Bing RSS returned unrelated results; the legacy website URL recorded in the official college information portal was not reachable.\",\"url\":\"https://www.bing.com/search?format=rss&q=mphighereducation.nic.in%2Fgpgcbareli\"}],\"course_catalogue_status\":\"verified_official_website\",\"courses\":[],\"agent_notes\":[\"Initial verification had to use curl --insecure for expected official/search hostnames after the managed proxy returned the exact certificate-chain error; no credentials were sent.\",\"The official government listing and current official ePravesh institution record were established, but the legacy site recorded by the department (http://www.mphighereducation.nic.in/gpgcbareli) was unreachable and the department profile URL is a generic profile route. The official course data is available through the ePravesh API, but a browsable institution course page is not independently established, so the record remains manual_review pending human confirmation of the institution website/catalogue evidence.\"]}"}}
