{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc 'page=$(find \"$TMPDIR\" -type f -name \"Form_EBrochure.aspx\" | tail -1) && tail -240 \"$page\" | head -240'","aggregated_output":"                    if ($scope.CollegeHostelT[id]) {\r\n                        selectedIDs.push(id);\r\n                    }\r\n                }\r\n\r\n                $scope.filters.chd_type_ids = selectedIDs.toString();\r\n                $scope.College_Details_all_filtered = angular.copy(applyFilters($scope.College_Details_all, $scope.filters));\r\n                $scope.College_Details = $scope.College_Details_all_filtered.slice(0, 50);\r\n                $scope.visibleCollegeCount = 50;\r\n\r\n                var dummyEvent = null;\r\n                var currentSearchText = $scope.searchText || \"\";\r\n                $scope.Search_College(dummyEvent, currentSearchText);\r\n\r\n                document.getElementById(\"Total_Counts\").innerText = $scope.College_Details_all_filtered.length;\r\n\r\n                setTimeout(() => {\r\n                    document.getElementById(\"preloader\").style.display = \"none\";\r\n                }, 200);\r\n            };\r\n\r\n            function applyFilters(arrayObj, filterObj) {\r\n                if (!arrayObj) return [];\r\n                return arrayObj.filter(item => {\r\n                    return Object.keys(filterObj).every(key => {\r\n                        let filterValue = String(filterObj[key]).trim();\r\n                        if (filterValue === \"\" || filterValue === \"null\" || filterValue === \"undefined\") return true;\r\n\r\n                        const itemValue = item[key];\r\n                        if (itemValue == null) return false;\r\n\r\n                        const itemStr = String(itemValue).trim();\r\n                        const filterParts = filterValue.split(',').map(v => v.trim());\r\n                        const itemParts = itemStr.split(/[/,]/).map(v => v.trim());\r\n\r\n                        return filterParts.some(fv => itemParts.includes(fv));\r\n                    });\r\n                });\r\n            }\r\n\r\n            // Redirect to College Detail page\r\n            $scope.Each_Collage_Data = function (cm_id) {\r\n                $.ajax({\r\n                    type: \"POST\",\r\n                    url: \"Form_EBrochure.aspx/Get_Incrypt_Decrypt_College_ID\",\r\n                    contentType: 'application/json; charset=utf-8',\r\n                    data: JSON.stringify({ cm_id: cm_id }),\r\n                    datatype: \"json\",\r\n                    beforeSend: function () {\r\n                        $('[id*=UpdateProgress]').css('display', '');\r\n                    },\r\n                    success: function (response) {\r\n                        if (response.d != \"[]\") {\r\n                            window.open('EBrochure_College_Details.aspx?cm_id=' + response.d, '_blank');\r\n                        }\r\n                    },\r\n                    error: function () {\r\n                        alert('Some error occurred.');\r\n                    },\r\n                    complete: function () {\r\n                        $('[id*=UpdateProgress]').css('display', 'none');\r\n                    }\r\n                });\r\n            };\r\n\r\n            // Fetch All Data\r\n            $scope.GetData = function () {\r\n                $(\"#preloader\").show();\r\n                $(document).ajaxSend(function (event, xhr, settings) {\r\n                    xhr.setRequestHeader(\"X-menu-id\", \"-1\");\r\n                });\r\n                $http({\r\n                    method: 'POST',\r\n                    async: true,\r\n                    url: \"Form_EBrochure.aspx/Bind_Form_EBrochure_All_Data\",\r\n                    data: {},\r\n                }).then(\r\n                    function (response) {\r\n                        try {\r\n                            if (response.data.d && response.data.d.toString() != '') {\r\n                                var dataSet = JSON.parse(response.data.d);\r\n                                $scope.Course_Binds = dataSet.Table || [];\r\n                                $scope.universities = dataSet.Table1 || [];\r\n                                $scope.collage_type = dataSet.Table2 || [];\r\n                                $scope.College_GEN_hostel = dataSet.Table3 || [];\r\n                                $scope.District_Bind = dataSet.Table4 || [];\r\n                                $scope.College_NAAC = dataSet.Table6 || [];\r\n\r\n                                if (!dataSet.Table5 || dataSet.Table5.length == 0) {\r\n                                    alert(\"No College Records Found\");\r\n                                    $(\"#preloader\").hide();\r\n                                    return;\r\n                                }\r\n\r\n                                $scope.College_Details_all = dataSet.Table5;\r\n                                $scope.College_Details = dataSet.Table5.slice(0, 50);\r\n                                $scope.visibleCollegeCount = 50;\r\n                                document.getElementById(\"Total_Counts\").innerText = $scope.College_Details_all.length;\r\n\r\n                                $scope.College_Details = $scope.College_Details.map(function (item) {\r\n                                    item.Course = $sce.trustAsHtml(item.Course ? String(item.Course) : '');\r\n                                    return item;\r\n                                });\r\n                                $scope.College_Details_all = $scope.College_Details_all.map(function (item) {\r\n                                    item.Course = $sce.trustAsHtml(item.Course ? String(item.Course) : '');\r\n                                    return item;\r\n                                });\r\n\r\n                                var allBranches = dataSet.Table7 || [];\r\n                                angular.forEach($scope.Course_Binds, function (course) {\r\n                                    course.isExpanded = false;\r\n                                    course.Branches = allBranches.filter(function (branch) {\r\n                                        return String(branch.dgre_id) === String(course.dgre_id);\r\n                                    });\r\n                                });\r\n                            }\r\n                        } catch (err) {\r\n                            console.error(\"Error: \", err);\r\n                        } finally {\r\n                            $(\"#preloader\").hide();\r\n                        }\r\n                    }\r\n                );\r\n            };\r\n\r\n            $scope.Toggle_Branch_Panel = function (course) {\r\n                course.isExpanded = !course.isExpanded;\r\n            };\r\n\r\n            $scope.Branch_Checkbox_Changed = function (course, branchId) {\r\n                var anyBranchChecked = false;\r\n                if (course.Branches && course.Branches.length > 0) {\r\n                    anyBranchChecked = course.Branches.some(function (b) {\r\n                        return $scope.BranchSelection && $scope.BranchSelection[b.bch_id] === true;\r\n                    });\r\n                }\r\n                $scope.CourseSelection[course.dgre_id] = anyBranchChecked;\r\n\r\n                document.getElementById(\"preloader\").style.display = \"block\";\r\n\r\n                let selectedBranchIDs = [];\r\n                for (let bId in $scope.BranchSelection) {\r\n                    if ($scope.BranchSelection[bId]) {\r\n                        selectedBranchIDs.push(bId);\r\n                    }\r\n                }\r\n\r\n                if (selectedBranchIDs.length > 0) {\r\n                    $scope.filters.Branch_id = selectedBranchIDs.toString();\r\n                } else {\r\n                    $scope.filters.Branch_id = \"\";\r\n                }\r\n\r\n                let selectedCourseIDs = [];\r\n                for (let cId in $scope.CourseSelection) {\r\n                    if ($scope.CourseSelection[cId]) {\r\n                        selectedCourseIDs.push(cId);\r\n                    }\r\n                }\r\n                if (selectedCourseIDs.length > 0) {\r\n                    $scope.filters.Course_id = selectedCourseIDs.toString();\r\n                } else {\r\n                    $scope.filters.Course_id = \"\";\r\n                }\r\n\r\n                $scope.College_Details_all_filtered = angular.copy(applyFilters($scope.College_Details_all, $scope.filters));\r\n\r\n                var currentSearchText = $scope.searchText || \"\";\r\n                if (currentSearchText.trim() !== \"\") {\r\n                    $scope.College_Details_all_filtered = $scope.College_Details_all_filtered.filter(function (item) {\r\n                        return item.College_Name.toLowerCase().includes(currentSearchText.toLowerCase());\r\n                    });\r\n                }\r\n\r\n                $scope.College_Details = $scope.College_Details_all_filtered.slice(0, 50);\r\n                $scope.visibleCollegeCount = 50;\r\n\r\n                document.getElementById(\"Total_Counts\").innerText = $scope.College_Details_all_filtered.length;\r\n                $scope.Data_Changes();\r\n\r\n                setTimeout(() => {\r\n                    document.getElementById(\"preloader\").style.display = \"none\";\r\n                }, 200);\r\n            };\r\n\r\n            $scope.Degree_Checkbox_Changed = function (course) {\r\n                var isDegreeChecked = $scope.CourseSelection[course.dgre_id];\r\n\r\n                if (course.Branches && course.Branches.length > 0) {\r\n                    angular.forEach(course.Branches, function (b) {\r\n                        $scope.BranchSelection[b.bch_id] = isDegreeChecked;\r\n                    });\r\n                }\r\n\r\n                $scope.Branch_Checkbox_Changed(course, null);\r\n            };\r\n\r\n            $scope.Auto_Expand_On_Search = function (searchText) {\r\n                if (!searchText || searchText.trim() === \"\") {\r\n                    angular.forEach($scope.Course_Binds, function (course) {\r\n                        course.isExpanded = false;\r\n                    });\r\n                    return;\r\n                }\r\n\r\n                angular.forEach($scope.Course_Binds, function (course) {\r\n                    var hasMatchingBranch = false;\r\n                    if (course.Branches && course.Branches.length > 0) {\r\n                        hasMatchingBranch = course.Branches.some(function (branch) {\r\n                            return branch.bch_name.toLowerCase().includes(searchText.toLowerCase());\r\n                        });\r\n                    }\r\n\r\n                    if (hasMatchingBranch) {\r\n                        course.isExpanded = true;\r\n                    }\r\n                });\r\n            };\r\n\r\n            $scope.Filter_Degrees_And_Branches = function (searchText) {\r\n                return function (course) {\r\n                    if (!searchText || searchText.trim() === \"\") return true;\r\n\r\n                    var searchLower = searchText.toLowerCase();\r\n                    var degreeMatches = course.dgre_short_name.toLowerCase().includes(searchLower);\r\n\r\n                    var branchMatches = false;\r\n                    if (course.Branches && course.Branches.length > 0) {\r\n                        branchMatches = course.Branches.some(function (branch) {\r\n                            return branch.bch_name.toLowerCase().includes(searchLower);\r\n                        });\r\n                    }\r\n\r\n                    return degreeMatches || branchMatches;\r\n                };\r\n            };\r\n        });\r\n    </script>\r\n</body>\r\n</html>","exit_code":0,