{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '183,225p' /Users/d111879/Documents/Project/DEMO/Student/Student_mobile/sapp/tooling/college_agents/common.py; sed -n '150,240p' /Users/d111879/Documents/Project/DEMO/Student/Student_mobile/sapp/tooling/college_agents/common.py; sed -n '1,220p' /Users/d111879/Documents/Project/DEMO/Student/Student_mobile/sapp/tooling/college_agents/agent_result.schema.json\"","aggregated_output":"def load_career_nodes(\n    database_path: Path = DATABASE_PATH,\n) -> dict[int, dict[str, Any]]:\n    connection = sqlite3.connect(f\"file:{database_path}?mode=ro\", uri=True)\n    connection.row_factory = sqlite3.Row\n    try:\n        nodes = {\n            row[\"id\"]: {\n                \"id\": row[\"id\"],\n                \"slug\": row[\"slug\"],\n                \"name\": row[\"name\"],\n                \"parent_id\": row[\"parent_id\"],\n            }\n            for row in connection.execute(\n                \"SELECT id, slug, name, parent_id FROM career_nodes\"\n            )\n        }\n    finally:\n        connection.close()\n\n    for node in nodes.values():\n        names: list[str] = []\n        seen: set[int] = set()\n        current_id: int | None = node[\"id\"]\n        while current_id is not None:\n            if current_id in seen:\n                raise ValueError(f\"Career-node cycle at {current_id}\")\n            seen.add(current_id)\n            current = nodes.get(current_id)\n            if current is None:\n                raise ValueError(f\"Missing career node {current_id}\")\n            names.append(current[\"name\"])\n            current_id = current[\"parent_id\"]\n        node[\"breadcrumb\"] = \" > \".join(reversed(names))\n    return nodes\n\n\ndef validate_agent_result(\n    result: dict[str, Any],\n    expected_institution_id: str,\n    *,\n    inventory_path: Path = INVENTORY_PATH,\n    database_path: Path = DATABASE_PATH,\n        ),\n    }\n    template = prompt_path.read_text(encoding=\"utf-8\")\n    return template.replace(\"{{STATE}}\", institution[\"state\"]).replace(\n        \"{{INSTITUTION_CONTEXT}}\",\n        json.dumps(context, ensure_ascii=False, indent=2),\n    )\n\n\ndef normalized_hostname(value: str) -> str:\n    hostname = urlparse(value).hostname or \"\"\n    return hostname.casefold().removeprefix(\"www.\")\n\n\ndef official_domains(result: dict[str, Any]) -> set[str]:\n    website = result.get(\"official_website\")\n    domains: set[str] = set()\n    if isinstance(website, str):\n        domains.add(normalized_hostname(website))\n    for domain in result.get(\"allowed_official_domains\", []):\n        if isinstance(domain, str):\n            domains.add(domain.casefold().removeprefix(\"www.\"))\n    return {domain for domain in domains if domain}\n\n\ndef is_official_url(url: str, domains: set[str]) -> bool:\n    hostname = normalized_hostname(url)\n    return any(\n        hostname == domain or hostname.endswith(f\".{domain}\")\n        for domain in domains\n    )\n\n\ndef load_career_nodes(\n    database_path: Path = DATABASE_PATH,\n) -> dict[int, dict[str, Any]]:\n    connection = sqlite3.connect(f\"file:{database_path}?mode=ro\", uri=True)\n    connection.row_factory = sqlite3.Row\n    try:\n        nodes = {\n            row[\"id\"]: {\n                \"id\": row[\"id\"],\n                \"slug\": row[\"slug\"],\n                \"name\": row[\"name\"],\n                \"parent_id\": row[\"parent_id\"],\n            }\n            for row in connection.execute(\n                \"SELECT id, slug, name, parent_id FROM career_nodes\"\n            )\n        }\n    finally:\n        connection.close()\n\n    for node in nodes.values():\n        names: list[str] = []\n        seen: set[int] = set()\n        current_id: int | None = node[\"id\"]\n        while current_id is not None:\n            if current_id in seen:\n                raise ValueError(f\"Career-node cycle at {current_id}\")\n            seen.add(current_id)\n            current = nodes.get(current_id)\n            if current is None:\n                raise ValueError(f\"Missing career node {current_id}\")\n            names.append(current[\"name\"])\n            current_id = current[\"parent_id\"]\n        node[\"breadcrumb\"] = \" > \".join(reversed(names))\n    return nodes\n\n\ndef validate_agent_result(\n    result: dict[str, Any],\n    expected_institution_id: str,\n    *,\n    inventory_path: Path = INVENTORY_PATH,\n    database_path: Path = DATABASE_PATH,\n) -> list[str]:\n    schema = load_json(SCHEMA_PATH)\n    validator = Draft202012Validator(\n        schema,\n        format_checker=FormatChecker(),\n    )\n    errors = [\n        f\"{'/'.join(str(part) for part in error.path) or '<root>'}: \"\n        f\"{error.message}\"\n        for error in sorted(validator.iter_errors(result), key=str)\n    ]\n    if errors:\n        return errors\n\n    if result[\"institution_id\"] != expected_institution_id:\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"State college official-site verification result\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"institution_id\",\n    \"nirf_name\",\n    \"government_listing_sources\",\n    \"verification_outcome\",\n    \"district\",\n    \"district_verification_status\",\n    \"official_website\",\n    \"website_verification_status\",\n    \"description\",\n    \"description_verification_status\",\n    \"record_status\",\n    \"allowed_official_domains\",\n    \"verification_sources\",\n    \"website_search_evidence\",\n    \"course_catalogue_status\",\n    \"courses\",\n    \"agent_notes\"\n  ],\n  \"properties\": {\n    \"institution_id\": {\"type\": \"string\", \"minLength\": 1},\n    \"nirf_name\": {\"type\": \"string\", \"minLength\": 1},\n    \"government_listing_sources\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"verification_outcome\": {\n      \"enum\": [\"verified\", \"remove_candidate\", \"manual_review\"]\n    },\n    \"district\": {\"type\": [\"string\", \"null\"]},\n    \"district_verification_status\": {\n      \"enum\": [\n        \"verified_official_website\",\n        \"pending_official_source\",\n        \"not_found\"\n      ]\n    },\n    \"official_website\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"website_verification_status\": {\n      \"enum\": [\"verified\", \"not_found\", \"ambiguous\"]\n    },\n    \"description\": {\"type\": [\"string\", \"null\"]},\n    \"description_verification_status\": {\n      \"enum\": [\"verified_official_website\", \"pending\", \"not_found\"]\n    },\n    \"record_status\": {\n      \"enum\": [\"verified\", \"remove_candidate\", \"manual_review\"]\n    },\n    \"allowed_official_domains\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"verification_sources\": {\n      \"type\": \"array\",\n      \"items\": {\"$ref\": \"#/$defs/source\"}\n    },\n    \"website_search_evidence\": {\n      \"type\": \"array\",\n      \"items\": {\"$ref\": \"#/$defs/searchEvidence\"}\n    },\n    \"course_catalogue_status\": {\n      \"enum\": [\n        \"verified_official_website\",\n        \"partial_official_website\",\n        \"not_found\"\n      ]\n    },\n    \"courses\": {\n      \"type\": \"array\",\n      \"items\": {\"$ref\": \"#/$defs/course\"}\n    },\n    \"agent_notes\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    }\n  },\n  \"$defs\": {\n    \"source\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"type\", \"url\", \"supports\"],\n      \"properties\": {\n        \"type\": {\"type\": \"string\", \"minLength\": 1},\n        \"url\": {\"type\": \"string\", \"minLength\": 1},\n        \"supports\": {\n          \"type\": \"array\",\n          \"minItems\": 1,\n          \"items\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"searchEvidence\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"query\", \"result\", \"url\"],\n      \"properties\": {\n        \"query\": {\"type\": \"string\", \"minLength\": 1},\n        \"result\": {\"type\": \"string\", \"minLength\": 1},\n        \"url\": {\"type\": [\"string\", \"null\"]}\n      }\n    },\n    \"mapping\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"career_node_id\",\n        \"career_node_slug\",\n        \"career_breadcrumb\",\n        \"relation\",\n        \"confidence\",\n        \"mapping_status\"\n      ],\n      \"properties\": {\n        \"career_node_id\": {\"type\": \"integer\", \"minimum\": 1},\n        \"career_node_slug\": {\"type\": \"string\", \"minLength\": 1},\n        \"career_breadcrumb\": {\"type\": \"string\", \"minLength\": 1},\n        \"relation\": {\"type\": \"string\", \"minLength\": 1},\n        \"confidence\": {\"enum\": [\"high\", \"medium\", \"low\"]},\n        \"mapping_status\": {\n          \"enum\": [\n            \"reviewed_against_local_tree\",\n            \"reviewed_with_career_tree_label_issue\"\n          ]\n        }\n      }\n    },\n    \"course\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"course_id\",\n        \"name\",\n        \"level\",\n        \"credential\",\n        \"specialization\",\n        \"duration\",\n        \"mode\",\n        \"eligibility\",\n        \"official_course_url\",\n        \"verification_status\",\n        \"career_path_mappings\",\n        \"mapping_gap\"\n      ],\n      \"properties\": {\n        \"course_id\": {\"type\": \"string\", \"minLength\": 1},\n        \"name\": {\"type\": \"string\", \"minLength\": 1},\n        \"level\": {\"type\": \"string\", \"minLength\": 1},\n        \"credential\": {\"type\": \"string\", \"minLength\": 1},\n        \"specialization\": {\"type\": [\"string\", \"null\"]},\n        \"duration\": {\"type\": [\"string\", \"null\"]},\n        \"mode\": {\"type\": \"string\", \"minLength\": 1},\n        \"eligibility\": {\"type\": [\"string\", \"null\"]},\n        \"official_course_url\": {\"type\": \"string\", \"minLength\": 1},\n        \"verification_status\": {\n          \"enum\": [\"verified\", \"verified_programme_family\"]\n        },\n        \"career_path_mappings\": {\n          \"type\": \"array\",\n          \"items\": {\"$ref\": \"#/$defs/mapping\"}\n        },\n        \"mapping_gap\": {\"type\": [\"string\", \"null\"]}\n      }\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
