{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc 'db=\"assets/data/career_path.db\"; sqlite3 -readonly \"$db\" <<'\"'SQL'\n.headers on\n.mode tabs\nWITH RECURSIVE tree(id,slug,stream_id,parent_id,name,breadcrumb,path) AS (\n  SELECT c.id,c.slug,c.stream_id,c.parent_id,c.name,s.name || ' > ' || c.name,printf('%04d',c.id)\n  FROM career_nodes c JOIN streams s ON s.id=c.stream_id WHERE c.parent_id IS NULL\n  UNION ALL\n  SELECT c.id,c.slug,c.stream_id,c.parent_id,c.name,t.breadcrumb || ' > ' || c.name,t.path||'/'||printf('%04d',c.id)\n  FROM career_nodes c JOIN tree t ON c.parent_id=t.id\n)\nSELECT id,slug,breadcrumb FROM tree WHERE id IN (348,349,68,70,71,72,73,269) ORDER BY id;\nSQL\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
