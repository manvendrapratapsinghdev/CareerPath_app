E,\n    PRIMARY KEY (node_id, institute_id)\n);\nCREATE TABLE node_job_sectors (\n    node_id       INTEGER NOT NULL REFERENCES career_nodes(id) ON DELETE CASCADE,\n    job_sector_id INTEGER NOT NULL REFERENCES job_sectors(id) ON DELETE CASCADE,\n    PRIMARY KEY (node_id, job_sector_id)\n);\nCREATE TABLE IF NOT EXISTS \"career_nodes\" (\n    id        INTEGER PRIMARY KEY,\n    slug      TEXT UNIQUE NOT NULL,\n    stream_id INTEGER NOT NULL REFERENCES streams(id) ON DELETE CASCADE,\n    parent_id INTEGER REFERENCES \"career_nodes\"(id) ON DELETE CASCADE,\n    name      TEXT NOT NULL,\n    intro     TEXT\n);\nCREATE UNIQUE INDEX idx_books_title ON books(title);\nCREATE UNIQUE INDEX idx_institutes_name ON institutes(name);\nCREATE UNIQUE INDEX idx_job_sectors_name ON job_sectors(name);\nCREATE UNIQUE INDEX idx_institutes_source_id\n            ON institutes(source_id)\n            WHERE source_id IS NOT NULL;\nCREATE INDEX idx_institutes_location\n            ON institutes(state, district, city);\nCREATE TABLE institute_courses (\n            id                  INTEGER PRIMARY KEY AUTOINCREMENT,\n            source_id           TEXT UNIQUE NOT NULL,\n            institute_id        INTEGER NOT NULL\n                                    REFERENCES institutes(id)\n                                    ON DELETE CASCADE,\n            name                TEXT NOT NULL,\n            level               TEXT NOT NULL,\n            credential          TEXT,\n            specialization      TEXT,\n            duration            TEXT,\n            mode                TEXT,\n            eligibility         TEXT,\n            official_course_url TEXT NOT NULL,\n            verification_status TEXT NOT NULL\n        , mapping_gap TEXT);\nCREATE INDEX idx_institute_courses_institute\n            ON institute_courses(institute_id);\nCREATE TABLE course_career_nodes (\n            course_id      INTEGER NOT NULL\n                               REFERENCES institute_courses(id)\n                               ON DELETE CASCADE,\n            node_id        INTEGER NOT NULL\n                               REFERENCES career_nodes(id)\n                               ON DELETE CASCADE,\n            relation       TEXT NOT NULL,\n            confidence     TEXT NOT NULL,\n            mapping_status TEXT NOT NULL,\n            PRIMARY KEY (course_id, node_id)\n        );\nCREATE INDEX idx_course_career_nodes_node\n            ON course_career_nodes(node_id);\nCREATE TABLE institute_categories (\n            institute_id INTEGER NOT NULL\n                             REFERENCES institutes(id)\n                             ON DELETE CASCADE,\n            category     TEXT NOT NULL,\n            PRIMARY KEY (institute_id, category)\n        );\nCREATE TABLE institute_rankings (\n            institute_id      INTEGER NOT NULL\n                                  REFERENCES institutes(id)\n                                  ON DELETE CASCADE,\n            system            TEXT NOT NULL,\n            year              INTEGER NOT NULL,\n            category          TEXT NOT NULL,\n            nirf_institute_id TEXT,\n            rank              INTEGER,\n            rank_band         TEXT,\n            score             REAL,\n            source_url        TEXT NOT NULL,\n            PRIMARY KEY (institute_id, system, year, category)\n        );\nCREATE INDEX idx_institute_rankings_order\n            ON institute_rankings(year, category, rank, rank_band);\nCREATE INDEX idx_institutes_type\n            ON institutes(institution_type);\n--- sample ---\nid  slug              stream_id  parent_id  name                                     intro             \n--  ----------------  ---------  ---------  ---------------------------------------  ------------------\n1   btech             1          335        B.Tech / B.E.                                              \n2   bsc_maths         1          335        B.Sc Mathematics                                           \n3   bca               1          335        BCA (Computer Applications)                                \n4   nda               1          335        NDA (National Defence Academy)                             \n5   merchant_navy     1          335        Merchant Navy                                              \n6   bsc_stats         1          335        B.Sc Statistics                                            \n7   integrated_msc    1          335        Integrated M.Sc (IISc/IISER)                               \n8   barch_sci         1          335        B.Arch (Architecture)                                      \n9   bsc_geology       1          335        B.Sc Geology / Earth Sciences                              \n10  bsc_meteorology   1          335        B.Sc Meteorology & Atmospheric Sciences                    \n11  diploma_engg      1          335        Diploma Engineering (Polytechnic)                          \n12  bsc_oceanography  1          335        B.Sc Oceanography / Marine Sciences                        \n13  cds_course        1          335        CDS / TES (Army Technical Entry)                           \n14  bsc_electronics   1          335        B.Sc Electronics / Instrumentation                         \n15  mbbs              1          336        MBBS                                                       \n16  bds               1          336        BDS (Dental Surgery)                                       \n17  bams              1          336        BAMS (Ayurveda)                                            \n18  bhms              1          336        BHMS (Homeopathy)                                          \n19  bsc_nursing       1          336        B.Sc Nursing                                               \n20  bpharm            1          336        Medical Updated                          Updated intro text\n","exit_code":0,"status":"completed"}}
