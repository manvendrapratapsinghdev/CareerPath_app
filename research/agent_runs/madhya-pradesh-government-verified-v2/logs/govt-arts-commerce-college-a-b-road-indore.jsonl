{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"db='assets/data/career_path.db'\nsqlite3 -readonly \\\"\"'$db\" <<'\"'SQL'\nWITH RECURSIVE path(id, slug, name, parent_id, depth, breadcrumb) AS (\n  SELECT id, slug, name, parent_id, 0, name FROM career_nodes WHERE parent_id IS NULL\n  UNION ALL\n  SELECT c.id, c.slug, c.name, c.parent_id, p.depth+1, p.breadcrumb || ' > ' || c.name\n  FROM career_nodes c JOIN path p ON c.parent_id=p.id\n)\nSELECT id AS career_node_id, slug AS career_node_slug, breadcrumb FROM path WHERE id IN (68,342,248,47,340,341);\nSQL\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
