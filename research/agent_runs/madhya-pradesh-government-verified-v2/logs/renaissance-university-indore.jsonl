parent: Sports & Physical Education for postgraduate sports')],\n 'phd-in-agriculture': [label(165, 'closest-specialization: Agricultural Scientist for doctoral agricultural research')],\n 'phd-commerce': [label(42, 'nearest-parent: B.Com / B.Com (Hons) for doctoral commerce')],\n 'phd-science': [label(80, 'closest-specialization: Computer Science for doctoral computer science')],\n 'phd-fashion': [label(57, 'closest-specialization: NIFT (Fashion Technology) for doctoral fashion research')],\n 'phd-journalism-and-mass-communication': [label(59, 'nearest-parent: B.J.M.C (Journalism & Mass Comm) for doctoral journalism')],\n 'phd-in-law': [M(343, 'nearest-parent: Law & Legal for doctoral law')],\n 'phd-in-library-science': [],\n 'phd-in-management': [M(342, 'nearest-parent: Management & Business for doctoral management')],\n 'phd-in-psychology': [label(66, 'nearest-parent: BA Psychology for doctoral psychology')],\n 'phd-in-science-chemistry': [label(155, 'closest-specialization: M.Sc Chemistry -> Researcher for doctoral chemistry')],\n 'b-pharmacy': [M(143, 'closest-specialization: Clinical Pharmacist for pharmacy', 'high')],\n 'd-pharma': [M(143, 'closest-specialization: Clinical Pharmacist for pharmacy', 'high')],\n}\n\n# Resolve the official course order from the complete official programme catalogue.\npreview = json.loads((root/'courses_preview.json').read_text())\nby_id = {c['courseId']: c for c in preview['content']}\nfees = json.loads((root/'programs_fees.json').read_text())\n\ndef level_credential(name):\n    low = name.lower()\n    if low.startswith('phd '): return 'doctoral', 'PhD'\n    if 'certificate' in low: return 'certificate', 'Certificate'\n    if 'diploma' in low or 'd.pharma' in low or low == 'general nursing midwifery': return 'diploma', 'Diploma'\n    if low == 'pgdca': return 'postgraduate', 'Postgraduate diploma'\n    if low == 'ipm': return 'integrated', 'Integrated degree programme'\n    if low.startswith(('m.', 'ma ', 'mba', 'llm', 'masters')): return 'postgraduate', \\\"Master's degree\\\"\n    return 'undergraduate', \\\"Bachelor's degree\\\"\n\nunmapped_reason = {\n    'b-lib': 'No library science or information science node exists in career_path.db.',\n    'm-lib': 'No library science or information science node exists in career_path.db.',\n    'phd-in-library-science': 'No library science or information science node exists in career_path.db.',\n    'b-voc-in-fire-safety': 'No fire or safety node exists in career_path.db.',\n    'm-voc-fire-safety': 'No fire or safety node exists in career_path.db.',\n}\n\ncourses = []\nseen = set()\nfor group in fees['data']:\n    for c in group['courses']:\n        cid = c['courseId']\n        d = by_id[cid]\n        ep = d['endPoint']\n        detail = json.loads((root/'course_details'/f'{ep}.json').read_text())['data']\n        assert detail['courseId'] == cid\n        assert ep in MAP, f'missing mapping for {ep}'\n        level, credential = level_credential(detail['name'])\n        courses.append({\n            'course_id': cid,\n            'name': detail['name'],\n            'level': level,\n            'credential': credential,\n            'specialization': None,\n            'duration': detail['duration'],\n            'mode': detail['courseType'],\n            'eligibility': None,\n            'official_course_url': f'https://renaissance.ac.in/courses/{ep}',\n            'verification_status': 'verified',\n            'career_path_mappings': MAP[ep],\n            'mapping_gap': None if MAP[ep] else unmapped_reason[ep],\n        })\n        seen.add(ep)\nassert len(courses) == 95\nassert len(seen) == 95\nassert sum(g['courseCount'] for g in json.loads((root/'programs_basic.json').read_text())['content']) == 95\nassert json.loads((root/'courses_preview.json').read_text())['totalElements'] == 95\n\nresult = {\n    'institution_id': 'renaissance-university-indore',\n    'nirf_name': 'RENAISSANCE UNIVERSITY INDORE',\n    'government_listing_sources': ['https://www.nirfindia.org/Rankings/2025/ManagementRankingALL.html'],\n    'verification_outcome': 'verified',\n    'district': 'Indore',\n    'district_verification_status': 'verified_official_website',\n    'official_website': 'https://renaissance.ac.in/',\n    'website_verification_status': 'verified',\n    'description': 'Renaissance University is an Indore, Madhya Pradesh university whose official site lists undergraduate, postgraduate, diploma, certificate, and doctoral programmes across management, commerce, engineering, law, science, agriculture, design, health, and other disciplines.',\n    'description_verification_status': 'verified_official_website',\n    'record_status': 'verified',\n    'allowed_official_domains': ['api.renaissance.ac.in'],\n    'verification_sources': [\n        {'type':'government_listing','url':'https://www.nirfindia.org/Rankings/2025/ManagementRankingALL.html','supports':['The NIRF 2025 Management ranking page lists RENAISSANCE UNIVERSITY INDORE in INDORE, Madhya Pradesh.']},\n        {'type':'official_homepage','url':'https://renaissance.ac.in/','supports':['Official homepage metadata identifies Renaissance University/RU Indore in Indore, Madhya Pradesh and describes its programme areas.']},\n        {'type':'official_about_page','url':'https://renaissance.ac.in/about-us','supports':['Official institutional identity page identifies Renaissance University in Indore, Madhya Pradesh.']},\n        {'type':'official_campus_identity_page','url':'https://renaissance.ac.in/contact-us','supports':['Official contact page/site footer identifies the campus as Gram Revti, Behind Aurobindo Hospital, Sanwer-Ujjain Road, Indore, Madhya Pradesh.']},\n        {'type':'official_programme_page','url':'https://renaissance.ac.in/school-of-management','supports':['Official School of Management programme route.']},\n        {'type':'official_admissions_catalogue_page','url':'https://renaissance.ac.in/admissions/program-course-fee-2026','supports':['Official admissions programme catalogue route.']},\n        {'type':'official_catalogue_api','url':'https://api.renaissance.ac.in/api/school-programs/public/get-all-basic-school-program?pageNumber=0&pageSize=100','supports':['Official public catalogue lists 15 programme groups with course counts totaling 95.']},\n        {'type':'official_catalogue_api','url':'https://api.renaissance.ac.in/api/school-programs/public/get-school-program-with-courses-and-fees','supports':['Official public catalogue lists all 95 current programme names and durations.']},\n        {'type':'official_course_index_api','url':'https://api.renaissance.ac.in/api/courses/public/get-all-preview-paginated-courses?pageNumber=0&pageSize=100','supports':['Official course index reports 95 records, matching the programme catalogue.']},\n    ],\n    'website_search_evidence': [\n        {'query':'Renaissance University Indore official website','result':'DuckDuckGo returned the official domain renaissance.ac.in; used only for discovery, with verification based on direct official pages and the official public API.','url':'https://renaissance.ac.in/'},\n        {'query':'Renaissance University Indore courses official site','result':'DuckDuckGo returned official Renaissance University catalogue routes on renaissance.ac.in; direct official pages and API responses were used for verification.','url':'https://renaissance.ac.in/admissions/program-course-fee-2026'},\n    ],\n    'course_catalogue_status':'verified_official_website',\n    'courses': courses,\n    'agent_notes': [\n        'Government listing, campus city, official identity, programme catalogue, and course-page routes were independently verified.',\n        'The official catalogue contains 15 programme groups and 95 active programmes; all 95 official /courses/{endpoint} routes returned HTTP 200.',\n        'Eligibility is left null because the central official catalogue does not state it uniformly; no brochure downloads were used.',\n        'Normal TLS verification first failed with the managed proxy exact self-signed-certificate-in-chain error; public GET requests then used curl --insecure only after confirming the expected official hostnames.',\n        'Career mappings were reviewed against the read-only career_path.db tree. Library-science and fire/safety programmes have empty mappings with mapping_gap explanations because no responsible nodes exist.',\n    ],\n}\nprint(json.dumps(result, ensure_ascii=False, separators=(',',':')))\nPY\njq -e 'type==\\\"object\\\" and .courses|length==95 and .record_status==\\\"verified\\\" and .course_catalogue_status==\\\"verified_official_website\\\"' \\\"\"'$TMPROOT/final_result.json\" >/dev/null\nprintf '\"'bytes='; wc -c < \\\"\"'$TMPROOT/final_result.json\"\nprintf '\"'courses='; jq '.courses|length' \\\"\"'$TMPROOT/final_result.json\"\nprintf '\"'unmapped='; jq '[.courses[] | select(.career_path_mappings|length==0)] | length' \\\"\"'$TMPROOT/final_result.json\"\nprintf '\"'modes='; jq -r '.courses[].mode' \\\"\"'$TMPROOT/final_result.json\" | sort | uniq -c'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
