                                       \n                          name      TEXT NOT NULL,                                                                                                                                                                           \n                          intro     TEXT                                                                                                                                                                                     \n                      )                                                                                                                                                                                                      \n\ncourse_career_nodes   CREATE TABLE course_career_nodes (                                                                                                                                                                     \n                                  course_id      INTEGER NOT NULL                                                                                                                                                            \n                                                     REFERENCES institute_courses(id)                                                                                                                                        \n                                                     ON DELETE CASCADE,                                                                                                                                                      \n                                  node_id        INTEGER NOT NULL                                                                                                                                                            \n                                                     REFERENCES career_nodes(id)                                                                                             