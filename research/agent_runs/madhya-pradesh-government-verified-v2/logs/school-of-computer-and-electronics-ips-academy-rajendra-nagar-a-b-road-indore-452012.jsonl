mission\": {\n      \"type\": \"accordion\",\n      \"sort_order\": 5,\n      \"items\": [\n        {\n          \"answer\": \"SOC IPS Academy aims to be one of the premier institutions of the country, dedicated to the creation, application, dissemination of knowledge, skills, spirit of competitive excellence, building up computing knowledge and skills as an essential component for futuristic work management.\",\n          \"question\": \"Vision\"\n        },\n        {\n          \"answer\": \"To create professional and technologically enabled manpower for meeting the current and future demands of the industry and society. To foster research and development culture in close interaction with the computing and technology industry, promoting synergistic partnerships with the industry.\",\n          \"question\": \"Mission\"\n        }\n      ],\n      \"title\": \"Vision & Mission\"\n    },\n    \"objective\": {\n      \"type\": \"text\",\n      \"sort_order\": 6,\n      \"image\": \"\",\n      \"title\": \"\",\n      \"content\": \"\"\n    },\n    \"learning_beyond_the_classroom\": {\n      \"type\": \"text\",\n      \"sort_order\": 7,\n      \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/kilmymhoogems5giqgkf.webp\",\n      \"title\": \"Code the future with computers\",\n      \"content\": \"A career in computers offers diverse opportunities in software development, data science, cybersecurity, and artificial intelligence, shaping the future of technology.\\nWith the rise of emerging and evolving technologies, graduates can build dynamic careers that drive innovation, problem-solving, and digital transformation across industries.\"\n    },\n    \"mentorship\": {\n      \"type\": \"text\",\n      \"sort_order\": 8,\n      \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/ikwar8tzhauiqqbcmggo.webp\",\n      \"title\": \"Mentorship That Makes the Difference\",\n      \"content\": \"With 25+ years of excellence, SOC bridges academia and industry through advanced teaching, research and industry collaboration. We equip students with technical skills and practical knowledge to excel in the tech industry. Backed by expert faculty and a dynamic curriculum, we prepare them for real-world challenges.\\n\\nDr. Manish Pundlik\\nDirector\"\n    },\n    \"programmed_offered\": {\n      \"type\": \"text\",\n      \"sort_order\": 9,\n      \"image\": \"\",\n      \"title\": \"Programs Offered\",\n      \"content\": \"From your first undergraduate step to a postgraduate specialization, choose a programme that fits where you're headed in the world of technology.\"\n    },\n    \"facilities\": {\n      \"type\": \"facilities\",\n      \"sort_order\": 10,\n      \"title\": \"Facilities\",\n      \"subtitle\": \"INFRASTRUCTURE TO INSPIRE AND SHAPE YOU \",\n      \"facilities\": [\n        {\n          \"name\": \"LIBRARY\",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/gjnokz5orcdfxr8sacuk.webp\",\n          \"description\": \"Collection of 35,000 books, cutting-edge online resources and subscriptions to 100+ journals.\"\n        },\n        {\n          \"name\": \"CLASSROOMS \",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/bk57uhmjooat1tf72p8p.webp\",\n          \"description\": \"Spacious, bright, well-ventilated classrooms with modern furniture and smart interactive panels.\"\n        },\n        {\n          \"name\": \"COMPUTER LABS \",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/gkwpjtmabhmtlbd6ljaa.webp\",\n          \"description\": \"Advanced systems and seamless Wi-Fi connectivity with tools for digital learning and research.\"\n        },\n        {\n          \"name\": \"SEMINAR HALL \",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/lehpenjsfs06vtbpzaop.webp\",\n          \"description\": \"Equipped with modern audio-visual facilities for a capacity of 300 seats.\"\n        },\n        {\n          \"name\": \"HOSTEL \",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/yrnjy7jdrn0mwubeilcq.webp\",\n          \"description\": \"On-campus girls hostel offers a safe and comfortable, homely environment.\"\n        },\n        {\n          \"name\": \" MESS AND CANTEEN \",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/igvj6bxsphxybd3r0qel.webp\",\n          \"description\": \"Our mess serves healthy, tasty, and hygienic meals for wholesome nutrition. \"\n        },\n        {\n          \"name\": \"TRANSPORT \",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/i4wvjc7tvtawbmhqgtph.webp\",\n          \"description\": \"A dedicated fleet of vehicles ensures smooth and convenient transport from the city and nearby locations. \"\n        },\n        {\n          \"name\": \"SPORTS\",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/xtwujscnwvw0hupc4dmp.webp\",\n          \"description\": \" Multiple indoor and outdoor activities to inculcate the spirit of fitness and teamwork, making sports a way of life, rather than just for recreation. \"\n        }\n      ],\n      \"description\": \"SOC is more than a campus. It is a thriving community to explore, learn and grow with like-minded peers. \\nOur vibrant campus offers you the space to discover and unleash your true potential. \"\n    },\n    \"placement\": {\n      \"type\": \"split\",\n      \"sort_order\": 11,\n      \"tag\": \"PLACEMENT\",\n      \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/yhlhepw93r07up5yx4r9.webp\",\n      \"items\": [],\n      \"title\": \"Careers with Leading Recruiters \",\n      \"description\": \"At the SOC, internships, placement guidance, skill training and our wide recruiter network enables top placements and success stories with leading organisations worldwide. \\n\\n\",\n      \"image_position\": \"right\"\n    },\n    \"proven_placement_record\": {\n      \"type\": \"features\",\n    