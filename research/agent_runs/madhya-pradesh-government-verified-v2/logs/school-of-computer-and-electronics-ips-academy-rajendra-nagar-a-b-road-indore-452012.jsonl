{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '180,225p' ../../../../../tooling/college_agents/common.py && sed -n '390,430p' ../../../../../tooling/college_agents/common.py && sed -n '100,145p' ../../../../../tooling/college_agents/agent_result.schema.json\"","aggregated_output":"    )\n\n\ndef load_career_nodes(\n    database_path: Path = DATABASE_PATH,\n) -> dict[int, dict[str, Any]]:\n    connection = sqlite3.connect(f\"file:{database_path}?mode=ro\", uri=True)\n    connection.row_factory = sqlite3.Row\n    try:\n        nodes = {\n            row[\"id\"]: {\n                \"id\": row[\"id\"],\n                \"slug\": row[\"slug\"],\n                \"name\": row[\"name\"],\n                \"parent_id\": row[\"parent_id\"],\n            }\n            for row in connection.execute(\n                \"SELECT id, slug, name, parent_id FROM career_nodes\"\n            )\n        }\n    finally:\n        connection.close()\n\n    for node in nodes.values():\n        names: list[str] = []\n        seen: set[int] = set()\n        current_id: int | None = node[\"id\"]\n        while current_id is not None:\n            if current_id in seen:\n                raise ValueError(f\"Career-node cycle at {current_id}\")\n            seen.add(current_id)\n            current = nodes.get(current_id)\n            if current is None:\n                raise ValueError(f\"Missing career node {current_id}\")\n            names.append(current[\"name\"])\n            current_id = current[\"parent_id\"]\n        node[\"breadcrumb\"] = \" > \".join(reversed(names))\n    return nodes\n\n\ndef validate_agent_result(\n    result: dict[str, Any],\n    expected_institution_id: str,\n    *,\n    inventory_path: Path = INVENTORY_PATH,\n    database_path: Path = DATABASE_PATH,\n    nodes = load_career_nodes(database_path)\n    course_ids: set[str] = set()\n    for course in result[\"courses\"]:\n        course_id = course[\"course_id\"]\n        if not course_id.startswith(f\"{expected_institution_id}-\"):\n            errors.append(\n                f\"{course_id}: course_id must start with \"\n                f\"{expected_institution_id}-\"\n            )\n        if course_id in course_ids:\n            errors.append(f\"duplicate course_id: {course_id}\")\n        course_ids.add(course_id)\n        mapping_ids: set[int] = set()\n        for mapping in course[\"career_path_mappings\"]:\n            node_id = mapping[\"career_node_id\"]\n            if node_id in mapping_ids:\n                errors.append(\n                    f\"{course_id}: duplicate career node {node_id}\"\n                )\n            mapping_ids.add(node_id)\n            node = nodes.get(node_id)\n            if node is None:\n                errors.append(f\"{course_id}: unknown career node {node_id}\")\n                continue\n            if mapping[\"career_node_slug\"] != node[\"slug\"]:\n                errors.append(\n                    f\"{course_id}: slug mismatch for career node {node_id}\"\n                )\n            if mapping[\"career_breadcrumb\"] != node[\"breadcrumb\"]:\n                errors.append(\n                    f\"{course_id}: breadcrumb mismatch for career node {node_id}\"\n                )\n    return errors\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"query\", \"result\", \"url\"],\n      \"properties\": {\n        \"query\": {\"type\": \"string\", \"minLength\": 1},\n        \"result\": {\"type\": \"string\", \"minLength\": 1},\n        \"url\": {\"type\": [\"string\", \"null\"]}\n      }\n    },\n    \"mapping\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"career_node_id\",\n        \"career_node_slug\",\n        \"career_breadcrumb\",\n        \"relation\",\n        \"confidence\",\n        \"mapping_status\"\n      ],\n      \"properties\": {\n        \"career_node_id\": {\"type\": \"integer\", \"minimum\": 1},\n        \"career_node_slug\": {\"type\": \"string\", \"minLength\": 1},\n        \"career_breadcrumb\": {\"type\": \"string\", \"minLength\": 1},\n        \"relation\": {\"type\": \"string\", \"minLength\": 1},\n        \"confidence\": {\"enum\": [\"high\", \"medium\", \"low\"]},\n        \"mapping_status\": {\n          \"enum\": [\n            \"reviewed_against_local_tree\",\n            \"reviewed_with_career_tree_label_issue\"\n          ]\n        }\n      }\n    },\n    \"course\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"course_id\",\n        \"name\",\n        \"level\",\n        \"credential\",\n        \"specialization\",\n        \"duration\",\n        \"mode\",\n        \"eligibility\",\n","exit_code":0,"status":"completed"}}
