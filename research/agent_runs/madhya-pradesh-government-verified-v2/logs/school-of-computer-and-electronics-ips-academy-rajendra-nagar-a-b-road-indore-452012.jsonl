\"sort_order\": 1,\n      \"image\": \"\",\n      \"title\": \"About IPS\",\n      \"content\": \"We are Central India’s leading multidisciplinary institution, known for excellence in academics, infrastructure and industry connect. Under the leadership of Nishit Jain a visionary educator, IPS Academy has grown into a vibrant 60 acre - ecosystem of learning.\"\n    },\n    \"ecosystem_for_your\": {\n      \"type\": \"accordion\",\n      \"sort_order\": 2,\n      \"items\": [\n        {\n          \"answer\": \"From tech-led classrooms to advanced labs and studios, find a world of excellence to lead the future.\",\n          \"question\": \"Ecosystem For Your Growth\"\n        },\n        {\n          \"answer\": \"Dive into industry-tailored, experiential learning to nurture your creativity with career-readiness.\",\n          \"question\": \"Learn Beyond Textbooks\"\n        },\n        {\n          \"answer\": \"Prepare for a successful career and get ready for global opportunities as a responsible and global-minded professional.\",\n          \"question\": \"Be A Global Citizen\"\n        },\n        {\n          \"answer\": \"Grow your network with IPS alumni all over the world.\",\n          \"question\": \"Connect With Alumni\"\n        }\n      ],\n      \"title\": \"Ecosystem For Your Growth\"\n    },\n    \"growth_image\": {\n      \"type\": \"gallery\",\n      \"sort_order\": 3,\n      \"title\": \"Ecosystem For Your Growth Image\",\n      \"images\": [\n        \"/uploads/growth_image_gallery_0.jpg\"\n      ]\n    },\n    \"vision_mission\": {\n      \"type\": \"accordion\",\n      \"sort_order\": 4,\n      \"items\": [\n        {\n          \"answer\": \"IPS Academy aims to be one of the premier institutions of the country, dedicated to the creation, application, dissemination of knowledge, skills, spirit of competitive excellence, building up generations of global citizens and value driven professionals for the corporate world and the society.\",\n          \"question\": \"Vision\"\n        },\n        {\n          \"answer\": \"To create professional manpower of the highest order for meeting the current and future demands of the industry and society. To nurture entrepreneurship capabilities amongst the students enabling them to be job providers instead of job seekers. To foster research and development culture in close interaction with the industry, promoting synergistic partnership with the industry, scientific world and society.\",\n          \"question\": \"Mission\"\n        }\n      ],\n      \"title\": \"Vision & Mission\"\n    },\n    \"leaders\": {\n      \"type\": \"team\",\n      \"sort_order\": 5,\n      \"title\": \"Our Leadership Team\",\n      \"members\": [\n        {\n          \"name\": \"Nishit Jain\",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/gczhjcwdnijij7oxxb9c.webp\",\n          \"title\": \"Director\",\n          \"description\": \"Students that walk into IPS Academy carry within them limitless potential. Our role is to give them the platform and tools to unlock it. As industries evolve and a new future of work unfolds, we are preparing our students to be more than job seekers but creators of opportunities and shape the world with confidence and competence. We are committed to dream big, and take bold steps into a new era led by constant change. The future is what we imagine today. I invite you to bring your dream and make it happen here at IPS.\"\n        },\n        {\n          \"name\": \"Achal Choudhary\",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/lc9vgn5dhlphvn3zvesm.webp\",\n          \"title\": \"President\",\n          \"description\": \"IPS Academy stands as a symbol of academic excellence and purposeful education. Today, with a rich legacy of 32 years with us, we continue to evolve, strengthening our industry connections, expanding innovation-driven learning, and preparing every student for a future where talent meets opportunity. Future-ready in vision and academic delivery, we remain committed to transforming your aspirations into achievements. Welcome to your future at IPS.\"\n        },\n        {\n          \"name\": \"Yogendra Jain\",\n          \"image\": \"https://portal.ipsa.ac.in/uploads/editor_images/ajw4zcimqtt5xc9xoxqx.webp\",\n          \"title\": \"Vice Director\",\n          \"description\": \"The world of work is changing fast. And so are we. At IPS Academy, our focus remains clear: to empower students with the skills, mindset, and exposure needed to excel in a global, technology-driven economy. Through powerful partnerships with industry and a tradition of high standards, we ensure our students don’t just prepare for the future, they make it happen confidently.\"\n        }\n      ]\n    }\n  }\n}\n\n=== official_portal_api_soc_pages_contact.json\n{\n  \"college\": \"soc\",\n  \"page\": \"contact\",\n  \"title\": \"contact\",\n  \"meta_description\": null,\n  \"meta_title\": null,\n  \"meta_keywords\": null,\n  \"canonical_url\": null,\n  \"robots\": \"index, follow\",\n  \"og_title\": null,\n  \"og_description\": null,\n  \"og_image\": null,\n  \"twitter_title\": null,\n  \"twitter_description\": null,\n  \"twitter_image\": null,\n  \"schema_markup\": null,\n  \"sections\": {\n    \"contact_us\": {\n      \"type\": \"contact\",\n      \"sort_order\": 1,\n      \"emails\": [\n        \"admission.soc@ipsacademy.org\",\n        \"office.soc@ipsacademy.org\"\n      ],\n      \"phones\": [\n        \"+91 731-4014858\",\n        \"+91 731-4014859\",\n        \"+91 8085224628\"\n      ],\n      \"address\": \"School Of Computers. IPS Academy Knowledge Village, Rajendra Nagar A.B. Road, Indore-452012.\"\n    }\n  }\n}\n\n=== official_portal_api_soc_pages_facilities.json\n{\n  \"college\": \"soc\",\n  \"page\": \"facilities\",\n  \"title\": \"Facilities\",\n  \"meta_description\": null,\n  \"meta_title\": null,\n  \"meta_keywords\": null,\n  \"canonical_url\": null,\n  \"r