ages/deparment.png')no-repeat;\r\n}\r\n\r\n.departmentSection .RightImg {\r\n    top: 0px;\r\n    right: 0px;\r\n    width: 175px;\r\n}\r\n\r\n.departmentSection .bottomImg {\r\n    bottom: 0px;\r\n    right: 50%;\r\n    width: 175px;\r\n}\r\n.departmentSection h1 { font-size: 60px;}\r\n.padding-right { padding-right: 50px;}\r\n.departmentSection p { font-size: 16px; line-height: 26px;}\r\n.btn-outline-warning { border-color: #ffffff; color: #ffffff; border-radius: 5px !important;}\r\n.listbox .card {width: 80%;\r\n    margin-bottom: 21px;}\r\n    .margin-left { margin-left: 20% !important;}\r\n.departmentCircle {\r\n    background: #e0e8f2;\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 100%;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n.departmentCircle img {\r\n    width: 45%;\r\n}\r\n\r\n.departmentSection .card-body p {\r\n    margin-bottom: 10px;\r\n    line-height: 24px;\r\n    font-size: 17px;\r\n    margin-top: 11px;\r\n\r\n}\r\n\r\n/*departmentSection section End*/\r\n/*aboutSection section start*/\r\n\r\n.aboutSection h1 {\r\n    font-size: 60px;\r\n    font-weight: 500;\r\n}\r\n\r\n.aboutSection p {\r\n    font-size: 15px;\r\n    font-weight: 500;\r\n}\r\n.aboutSectionFeature img {\r\n    margin-right: 15px;\r\n    width: 55px;\r\n    height: 55px;\r\n}\r\n\r\n.aboutSectionFeature h4 {\r\n    font-size: 21px;\r\n    font-weight: 600;\r\n}\r\n\r\n/*aboutSection section End*/\r\n/*NewsEventsSection section Start*/\r\n\r\n\r\n.NewsSlider .card { border: none;}\r\n\r\n.NewsSlider .owl-stage-outer{ box-shadow: 0px 3px 20px rgba(0, 0, 0, 0.16);border-radius: 10px;}\r\n\r\n.NewsEventsSection {\r\n    background: url('../images/EventsBg.png') no-repeat;\r\n    background-size: cover\r\n}\r\n\r\n.newsUls {\r\n    margin-top: 25px;\r\n}\r\n\r\n.newsUls li {\r\n    width: calc(100% / 2 - 30px);\r\n    margin-right: 15px;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.newsUls li 