{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"sed -n '178,218p' ../../../../../tooling/college_agents/common.py && sed -n '40,85p' ../../../../../tooling/validate_verifications.py\"","aggregated_output":"def load_career_nodes(\n    database_path: Path = DATABASE_PATH,\n) -> dict[int, dict[str, Any]]:\n    connection = sqlite3.connect(f\"file:{database_path}?mode=ro\", uri=True)\n    connection.row_factory = sqlite3.Row\n    try:\n        nodes = {\n            row[\"id\"]: {\n                \"id\": row[\"id\"],\n                \"slug\": row[\"slug\"],\n                \"name\": row[\"name\"],\n                \"parent_id\": row[\"parent_id\"],\n            }\n            for row in connection.execute(\n                \"SELECT id, slug, name, parent_id FROM career_nodes\"\n            )\n        }\n    finally:\n        connection.close()\n\n    for node in nodes.values():\n        names: list[str] = []\n        seen: set[int] = set()\n        current_id: int | None = node[\"id\"]\n        while current_id is not None:\n            if current_id in seen:\n                raise ValueError(f\"Career-node cycle at {current_id}\")\n            seen.add(current_id)\n            current = nodes.get(current_id)\n            if current is None:\n                raise ValueError(f\"Missing career node {current_id}\")\n            names.append(current[\"name\"])\n            current_id = current[\"parent_id\"]\n        node[\"breadcrumb\"] = \" > \".join(reversed(names))\n    return nodes\n\n\ndef validate_agent_result(\n    result: dict[str, Any],\n    expected_institution_id: str,\n    *,\n\ndef load_career_nodes(database_path: Path) -> dict[int, dict[str, Any]]:\n    connection = sqlite3.connect(database_path)\n    connection.row_factory = sqlite3.Row\n    try:\n        nodes = {\n            row[\"id\"]: {\n                \"id\": row[\"id\"],\n                \"slug\": row[\"slug\"],\n                \"name\": row[\"name\"],\n                \"parent_id\": row[\"parent_id\"],\n            }\n            for row in connection.execute(\n                \"SELECT id, slug, name, parent_id FROM career_nodes\"\n            )\n        }\n    finally:\n        connection.close()\n\n    for node in nodes.values():\n        names: list[str] = []\n        seen: set[int] = set()\n        current_id: int | None = node[\"id\"]\n        while current_id is not None:\n            if current_id in seen:\n                raise ValueError(\n                    f\"Cycle detected in career_nodes at node {current_id}\"\n                )\n            seen.add(current_id)\n            current = nodes.get(current_id)\n            if current is None:\n                raise ValueError(\n                    f\"Missing career_nodes parent referenced by {current_id}\"\n                )\n            names.append(current[\"name\"])\n            current_id = current[\"parent_id\"]\n        node[\"breadcrumb\"] = \" > \".join(reversed(names))\n    return nodes\n\n\ndef is_http_url(value: Any) -> bool:\n    if not isinstance(value, str):\n        return False\n    parsed = urlparse(value)\n    return parsed.scheme in {\"http\", \"https\"} and bool(parsed.netloc)\n\n","exit_code":0,"status":"completed"}}
