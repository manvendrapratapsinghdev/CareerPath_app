\n}\r\n\r\n@media (min-width:1400px) {\r\n    .container.width-85 {\r\n        max-width: 85%;\r\n        min-width: 85%;\r\n    }\r\n\r\n    .container.width-75 {\r\n        max-width: 75%;\r\n        min-width: 75%;\r\n    }\r\n}\r\n\r\n.nav-item.dropdown:hover>.dropdown-menu {\r\n    display: block !important;\r\n}\r\n\r\n\r\n\r\n/* Slider */\r\n.slick-slider {\r\n    position: relative;\r\n    display: block;\r\n    box-sizing: border-box;\r\n    -webkit-user-select: none;\r\n    -moz-user-select: none;\r\n    -ms-user-select: none;\r\n    user-select: none;\r\n    -webkit-touch-callout: none;\r\n    -khtml-user-select: none;\r\n    -ms-touch-action: pan-y;\r\n    touch-action: pan-y;\r\n    -webkit-tap-highlight-color: transparent;\r\n}\r\n\r\n.slick-list {\r\n    position: relative;\r\n    display: block;\r\n    overflow: hidden;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n    .slick-list:focus {\r\n        outline: none;\r\n    }\r\n\r\n    .slick-list.dragging {\r\n        cursor: pointer;\r\n        cursor: hand;\r\n    }\r\n\r\n.slick-slider .slick-track,\r\n.slick-slider .slick-list {\r\n    -webkit-transform: translate3d(0, 0, 0);\r\n    -moz-transform: translate3d(0, 0, 0);\r\n    -ms-transform: translate3d(0, 0, 0);\r\n    -o-transform: translate3d(0, 0, 0);\r\n    transform: translate3d(0, 0, 0);\r\n}\r\n\r\n.slick-track {\r\n    position: relative;\r\n    top: 0;\r\n    left: 0;\r\n    display: block;\r\n}\r\n\r\n    .slick-track:before,\r\n    .slick-track:after {\r\n        display: table;\r\n        content: '';\r\n    }\r\n\r\n    .slick-track:after {\r\n        clear: both;\r\n    }\r\n\r\n.slick-loading .slick-track {\r\n    visibility: hidden;\r\n}\r\n\r\n.slick-slide {\r\n    display: none;\r\n    float: left;\r\n    height: 100%;\r\n    min-height: 1px;\r\n}\r\n\r\n[dir='rtl'] .slick-slide {\r\n    float: right;\r\n}\r\n\r\n.slick-slide img {\r\n    display: block;\r\n}\r\n\r\n.slick-slide.slick-loading img {\r\n    display: none;\r\n}\r\n\r\n.slick-slide.dragging img {\r\n    pointer-events: none;\r\n}\r\n\r\n.slick-initialized .slick-slide {\r\n    display: block;\r\n}\r\n\r\n.slick-loading .slick-slide {\r\n    visibility: hidden;\r\n}\r\n\r\n.slick-vertical .slick-slide {\r\n    display: block;\r\n    height: auto;\r\n    border: 1px solid transparent;\r\n}\r\n\r\n.slick-arrow.slick-hidden {\r\n    display: none;\r\n}\r\n\r\n\r\n.flashNews {\r\n    background: linear-gradient(45deg, var(--ColorBlue), var(--ColorPurple));\r\n}\r\n\r\n.FlashnewsSlider .owl-dots {\r\n    display: none !important;\r\n}\r\n\r\n.newsArrow {\r\n    background: var(--orange);\r\n    height: 40px;\r\n    position: relative;\r\n    width: calc(100% - 20px);\r\n}\r\n\r\n    .newsArrow::after {\r\n        position: absolute;\r\n        right: -20px;\r\n        top: 0px;\r\n        content: '';\r\n        width: 0px;\r\n        height: 0px;\r\n        border-top: 20px solid transparent;\r\n        border-bottom: 20px solid transparent;\r\n        border-left: 20px solid var(--orange);\r\n    }\r\n\r\n.NewsSlider .owl-dots {\r\n    display: none !important;\r\n}\r\n\r\n.f-600 {\r\n    font-weight: 600;\r\n}\r\n\r\n.customNavOwl button {\r\n    border-radius: 100%;\r\n    border: solid 1px #fff;\r\n    outline: none;\r\n    background: none;\r\n    color: #fff;\r\n    width: 28px;\r\n    height: 28px;\r\n    cursor: pointer;\r\n    background: var(--orange);\r\n}\r\n\r\n    .customNavOwl button.owl-prev {\r\n        margin-right: 5px;\r\n    }\r\n\r\n.MarqueeUpper li a {\r\n    padding: 12px 0px !important;\r\n    border-bottom: dashed 1px #adadad;\r\n    display: block;\r\n    color: #333;\r\n}\r\n\r\n    .MarqueeUpper li a p {\r\n        margin: 0px;\r\n    }\r\n\r\n    .MarqueeUpper li a .dateMarqeeu {\r\n        width: 75px;\r\n        background: linear-gradient(90deg, var(--ColorBlue), var(--ColorPurple));\r\n        color: #fff;\r\n    }\r\n\r\n        .MarqueeUpper li a .dateMarqeeu i {\r\n            font-size: 34px;\r\n        }\r\n\r\n        .MarqueeUpper li a .dateMarqeeu span {\r\n            font-size: 11px;\r\n            display: block;\r\n            margin-top: 5px;\r\n        }\r\n\r\n    .MarqueeUpper li a .ContentMarqeeu {\r\n        width: calc(100% - 75px);\r\n        padding-left: 8px;\r\n    }\r\n\r\na, a:hover {\r\n    text-decoration: none !important;\r\n    cursor: pointer !important;\r\n}\r\n\r\n\r\n.videoGallery {\r\n    background: url('../images/videos.jpg') no-repeat fixed;\r\n    background-size: cover;\r\n    position: relative;\r\n}\r\n\r\n.playBtnToggle {\r\n    background: var(--orange);\r\n    width: 80px;\r\n    height: 80px;\r\n    border-radius: 100%;\r\n    font-size: 44px;\r\n    color: #fff;\r\n    padding-left: 12px;\r\n    animation: shadow-pulse 1s infinite;\r\n}\r\n\r\n@keyframes shadow-pulse {\r\n    0% {\r\n        box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.6);\r\n    }\r\n\r\n    100% {\r\n        box-shadow: 0 0 0 35px rgba(0, 0, 0, 0);\r\n    }\r\n}\r\n\r\n@keyframes shadow-pulse-big {\r\n    0% {\r\n        box-shadow: 0 0 0 0px rgba(0, 0, 0, 0.3);\r\n    }\r\n\r\n    100% {\r\n        box-shadow: 0 0 0 70px rgba(0, 0, 0, 0);\r\n    }\r\n}\r\n\r\n.videoGalleryModalData h4 {\r\n    color: var(--orange);\r\n    margin-top: 15px;\r\n    text-align: center;\r\n}\r\n\r\n.videoGalleryModalData p {\r\n    color: var(--textLightblack);\r\n    margin-bottom: 0px;\r\n    text-align: center;\r\n}\r\n\r\n.photoGallery .imgDptGallery {\r\n    width: calc(100% / 5);\r\n    position: relative;\r\n    max-height: 260px;\r\n    min-height: 260px;\r\n    overflow: hidden;\r\n}\r\n\r\n    .photoGallery  img {\r\n        max-height: 260px;\r\n        min-height: 260px;\r\n        object-fit: cover;\r\n    }\r\n\r\n.galleryContent {\r\n    position: absolute;\r\n    bottom: -100%;\r\n    background: rgba(0, 0, 0, 0.6);\r\n    width: 100%;\r\n    transition: all .2s;\r\n}\r\n    .galleryContent h4 {\r\n        color:#fff !important;\r\n    }\r\n\r\n\r\n\r\n\r\n\r\n    .photoGallery .imgDptGallery:hover .galleryContent {\r\n        bottom: 0px !important;\r\n    }\r\n.layerLightBlue {\r\n    background: linear-gradient(45deg, var(--ColorBlue), var(--ColorPurple));\r\n    position: absolute;\r\n    left: 0px;\r\n    top: 0px;\r\n    width: 100%;\r\n    height: 100%;\r\n    opacity:0.85;\r\n}\r\n\r\n\r\n/*#Slider .item::after {\r\n    position: absolute;\r\n    top: 0px;\r\n    left: 0px;\r\n    height: 100%;\r\n    content: \"\";\r\n    width: 100%;\r\n    background: linear-gradient(45deg, #027dda, #00af9e);\r\n    z-index:99;\r\n    opacity:0.7;\r\n}*/\r\n\r\n\r\n@media  (max-width:991px) {\r\n\r\n.ministerData .col-1 {\r\n\twidth:50% !important;\r\n}\r\n\r\n}\r\n\r\n\r\n@media  (max-width:767px) {\r\n\r\n.ministerData .col-1 {\r\n\twidth:100% !important;\r\n}\r\n\r\n}\r\n</style>\r\n<div id=\"startDiv\">\r\n    <div class=\"cm-tabs-content bg\">\n    <div id=\"content_location_1\">\n        <div  class=\"6\" >\n            <div id=\"GridContainer_1\"></div>\n            <div   class=\" container-fluid topBar\"  >\n                \n                <div   class=\" container width-85\"   >\n                    \n                    <div   class=\" row align-items-center\"  >\n                        \n                        <div   class=\" col-lg-4 col-md-12 col-sm-12 col-12 socialMedia py-2 d-flex align-items-center\"  >\n                            \n                            <div    ><ul class=\"d-flex align-items-center socialIcons\">\n                        <li><span>Follow us</span></li>\n                        <li><a href=\"javascript:void(0)\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"d-flex justify-content-center align-items-center\"><i class=\"fa fa-facebook-f\"></i></a></li>\n                        <li><a href=\"https://x.com/ccerajasthan\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"d-flex justify-content-center align-items-center\"><i class=\"fa fa-twitter\"></i></a></li>\n                        <li><a href=\"javascript:void(0)\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"d-flex justify-content-center align-items-center\"><i class=\"fa fa-instagram\"></i></a></li>\n                        <li><a href=\"javascript:void(0)\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"d-flex justify-content-center align-items-center\"><i class=\"fa fa-youtube-play\"></i></a></li>\n                        <li><a href=\"javascript:void(0)\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"d-flex justify-content-center align-items-center\"><i class=\"fa fa-linkedin\"></i></a></li>\n                    </ul></div>\n                        </div>\n                        <div   class=\" col-lg-8 col-md-12 col-sm-12 col-12 py-2 accebilities\"  >\n                            \n                            <div    >\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function () {\r\n\r\n\r\n        $('#_biggify').on('click', function () {\r\n\r\n\r\n\r\n            var fontSize = $('body').css('font-size');\r\n            var newFontSize = parseInt(fontSize) + 1;\r\n\r\n\r\n\r\n            $('body').css('font-size', newFontSize + 'px')\r\n            $('a').css('font-size', newFontSize + 'px')\r\n            $('Div').css('font-size', newFontSize + 'px')\r\n            $('p').css('font-size', newFontSize + 'px')\r\n            $('h1').css('font-size', newFontSize + 'px')\r\n            $('h2').css('font-size', newFontSize + 'px')\r\n            $('h3').css('font-size', newFontSize + 'px')\r\n            $('h4').css('font-size', newFontSize + 'px')\r\n            $('h5').css('font-size', newFontSize + 'px')\r\n            $('h6').css('font-size', newFontSize + 'px')\r\n            $('select').css('font-size', newFontSize + 'px')\r\n            $('input').css('font-size', newFontSize + 'px')\r\n            $('button').css('font-size', newFontSize + 'px')\r\n            $('textarea').css('font-size', newFontSize + 'px')\r\n\r\n\r\n\r\n        })\r\n\r\n\r\n\r\n        $('#_smallify').on('click', function () {\r\n            var fontSize = $('body').css('font-size');\r\n            var newFontSize = parseInt(fontSize) - 1;\r\n\r\n\r\n\r\n            $('body').css('font-size', newFontSize + 'px')\r\n            $('a').css('font-size', newFontSize + 'px')\r\n            $('Div').css('font-size', newFontSize + 'px')\r\n            $('p').css('font-size', newFontSize + 'px')\r\n            $('h1').css('font-size', newFontSize + 'px')\r\n            $('h2').css('font-size', newFontSize + 'px')\r\n            $('h3').css('font-size', newFontSize + 'px')\r\n            $('h4').css('font-size', newFontSize + 'px')\r\n            $('h5').css('font-size', newFontSize + 'px')\r\n            $('h6').css('font-size', newFontSize + 'px')\r\n            $('select').css('font-size', newFontSize + 'px')\r\n            $('input').css('font-size', newFontSize + 'px')\r\n            $('button').css('font-size', newFontSize + 'px')\r\n            $('textarea').css('font-size', newFontSize + 'px')\r\n        })\r\n\r\n\r\n\r\n        $('#_reset').on('click', function () {\r\n            //$('body').css('font-size', '14px')\r\n            //$('Div').css('font-size', '14px')\r\n            //$('p').css('font-size', '14px')\r\n            //$('a').removeAttr(\"style\").attr(\"font-size\", \"\");\r\n            location.reload();\r\n        })\r\n    });\r\n\r\n</script>\r\n<script type=\"text/javascript\">\r\n    function changetheme(id) {\r\n\r\n        $.ajax({\r\n            url: '/WebCMS/ChangeTheme',\r\n             type: \"POST\",\r\n             dataType: \"JSON\",\r\n             data: { _Id: id },\r\n             success: function () {\r\n             }\r\n         });\r\n\r\n\r\n        window.location.reload();\r\n    }\r\n\r\n    function SetThemeOption() {\r\n\r\n        $.ajax({\r\n            url: '/WebCMS/SetThemeOption',\r\n             type: \"POST\",\r\n             dataType: \"JSON\",\r\n             success: function (Data) {\r\n\r\n\r\n             }\r\n         });\r\n\r\n    }\r\n\r\n    function setFocus()\r\n    {\r\n        if ($(\".slider\").next('div').length) {\r\n            $(window).scrollTop($(\"#GridContainer_2\").next('div').offset().top);\r\n        }\r\n        else if ($(\".slider\").next('div').length) {\r\n            $(window).scrollTop($(\"#GridContainer_2\").next('div').offset().top);\r\n        }\r\n        return true;\r\n    }\r\n    //function setFocus()\r\n    //{\r\n    //    if ($(\".slider\").next('div').length) {\r\n    //        alert('1');\r\n    //        $(window).scrollTop($(\".slider\").next('div').offset().top);\r\n    //    }\r\n    //    else if ($(\".dev-aboutus\").length) {\r\n    //        alert('2');\r\n    //        $(window).scrollTop($('.dev-aboutus').offset().top);\r\n\r\n    //    }\r\n    //    return true;\r\n    //}\r\n</script>\r\n<script type=\"text/javascript\">\r\n    function printData() {\r\n        var x = document.getElementsByClassName(\"mystyle\")[0].className;\r\n        var divToPrint = document.getElementsByClassName(\"wrapper\");\r\n        newWin = window.open(\"\");\r\n        newWin.document.write(divToPrint[0].outerHTML);\r\n        newWin.print();\r\n        newWin.close();\r\n        window.print();\r\n    }\r\n\r\n\r\n    $(document).ready(function () {\r\n        $('#ddlclickprint').on('click', function () {\r\n            printData();\r\n        });\r\n    });\r\n</script>\r\n<style>\r\n    .dev-themesize input[type=text]:focus {\r\n        width: 100%;\r\n        color: #fff;\r\n        padding: 0px 0px 0px 40px;\r\n        outline: none !important;\r\n    }\r\n\r\n    .dev-themesize input[type=text] {\r\n        width: 0px;\r\n        box-sizing: border-box;\r\n        border: none !important;\r\n        background-color: rgba(0,0,0,0.4);\r\n        background-image: url(/images/searchicon1.png);\r\n        background-position: 6px 9px;\r\n        background-repeat: no-repeat;\r\n        padding: 0px 20px 0px 15px;\r\n        -webkit-transition: width 0.4s ease-in-out;\r\n        transition: width 0.4s ease-in-out;\r\n        margin: 0 0.3rem;\r\n    }\r\n\r\n    @media(max-width:991px) {\r\n        .socialMedia {\r\n            justify-content: center !important;\r\n        }\r\n    }\r\n</style>\r\n\r\n\r\n<div id=\"google_translate_element\" style=\"display:none\"></div>\r\n<ul class=\"d-flex align-items-center w-100 justify-content-end flex-wrap\">\r\n    <li> <a aria-current=\"page\" href=\"/WebCMS/ChangeWebsite/-999\">HTE</a> </li>\r\n    \r\n    \r\n    \r\n    <li> <a href=\"https://hte.rajasthan.gov.in/HTE/96322\"><i class=\"fa fa-volume-up\" aria-hidden=\"true\"></i> Screen Reader Access</a> </li>\r\n    <li> <a onclick=\"setFocus()\" href=\"javascript:void()\" style=\"cursor:pointer;\"><i class=\"fa fa-angle-double-down\" aria-hidden=\"true\"></i> Skip to main content </a> </li>\r\n    <li><a href=\"javascript:void()\" id=\"_smallify\">A<i class=\"fa fa-minus\" style=\"font-size: 7px;\"></i></a></li>\r\n    <li><a href=\"javascript:void()\" id=\"_reset\">A</a></li>\r\n    <li><a href=\"javascript:void()\" id=\"_biggify\">A<i class=\"fa fa-plus\" style=\"font-size: 7px;\"></i></a></li>\r\n    \r\n    \r\n    <li class=\"dropdown\">\r\n        <a href=\"#\" class=\"dropdown-toggle\" id=\"LanguageChangess\" data-bs-toggle=\"dropdown\" aria-expanded=\"false\">\r\n            English\r\n        </a>\r\n        <ul class=\"dropdown-menu\" aria-labelledby=\"LanguageChangess\">\r\n            <li><a id=\"lan_ENG\" href=\"#\" onclick=\"changeLanguageByButtonClick('en')\">English</a></li>\r\n            <li><a id=\"lan_HIN\" href=\"#\" onclick=\"changeLanguageByButtonClick('hi')\">Hindi</a></li>\r\n        </ul>\r\n    </li>\r\n    <li>\r\n        <a href=\"#\" class=\"dropdown-toggle\" id=\"SearchBoxs\" data-bs-toggle=\"dropdown\" aria-expanded=\"false\">\r\n            <i class=\"fa fa-search\"></i>\r\n        </a>\r\n        <ul class=\"dropdown-menu dropdown-menu-right\" aria-labelledby=\"SearchBoxs\" style=\"padding:0px !important;\">\r\n            <li class=\"d-flex\">\r\n\r\n                <input type=\"text\" id=\"txtSearchBox\" placeholder=\"Search here...\" class=\"form-control\" /><button type=\"button\" onclick=\"js_searchData()\"><i class=\"fa fa-search\"></i></button>\r\n\r\n                \r\n            </li>\r\n        </ul>\r\n    </li>\r\n</ul>\r\n\r\n\r\n<div class=\"modal fade\" id=\"SearchResults\" tabindex=\"-1\" aria-labelledby=\"exampleModalLabel\" aria-hidden=\"true\">\r\n    <div class=\"modal-dialog modal-lg\">\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <h5 class=\"modal-title\" id=\"exampleModalLabel\">Search Result</h5>\r\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <p><b>Search Result:</b> Page Name or inner page content.</p>\r\n                <div class=\"table-responsive\">\r\n                    <table class=\"table table-striped table-hover\">\r\n                        <thead>\r\n                            <tr>\r\n                                <th>Page Name</th>\r\n                                <th>Action</th>\r\n                            </tr>\r\n                        </thead>\r\n                        <tbody id=\"ResultSearchData\">\r\n                        </tbody>\r\n                    </table>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n\r\n<style>\r\n    .goog-te-banner-frame.skiptranslate {\r\n        display: none !important;\r\n    }\r\n\r\n    body {\r\n        top: 0px !important;\r\n    }\r\n\r\n    .dropdown-menu.show li {\r\n        display: block;\r\n        float: left;\r\n        width: 100%;\r\n    }\r\n\r\n        .dropdown-menu.show li a {\r\n            color: #333 !important;\r\n            border-bottom: dashed 1px rgba(0,0,0,0.4);\r\n            display: block;\r\n        }\r\n</style>\r\n\r\n<script type=\"text/javascript\">\r\n\r\n\r\n\r\n    function googleTranslateElementInit() {\r\n        new google.translate.TranslateElement({ pageLanguage: \"en\" }, 'google_translate_element');\r\n\r\n    }\r\n\r\n    function changeLanguageByButtonClick(ln) {\r\n\r\n        var language = ln;\r\n        if (ln == 'en') {\r\n            $('#dLabel').html('English <span class=\"caret\"></span>');\r\n        }\r\n        else if (ln == 'hi') {\r\n            $('#dLabel').html('हिंदी <span class=\"caret\"></span>');\r\n        }\r\n        else {\r\n            $('#dLabel').html('English <span class=\"caret\"></span>');\r\n        }\r\n        $('#dLabel').val();\r\n\r\n        var selectField = document.querySelector(\"#google_translate_element select\");\r\n        console.log(selectField);\r\n        for (var i = 0; i < selectField.children.length; i++) {\r\n            var option = selectField.children[i];\r\n            // find desired langauge and change the former language of the hidden selection-field\r\n            if (option.value == language) {\r\n                selectField.selectedIndex = i;\r\n                // trigger change event afterwards to make google-lib translate this side\r\n                selectField.dispatchEvent(new Event('change'));\r\n                break;\r\n            }\r\n        }\r\n\r\n\r\n        if (ln == 'en') {\r\n            window.location.reload(true);\r\n            //$('#dLabel').text('English');\r\n            //$('#lan_ENG').css('display', 'none');\r\n            //$('#lan_HIN').css('display', 'block');\r\n        }\r\n        //else if (ln == 'hi') {\r\n        //    $('#dLabel').text('हिंदी');\r\n        //    $('#lan_ENG').css('display', 'block');\r\n        //    $('#lan_HIN').css('display', 'none');\r\n        //}\r\n    }\r\n\r\n\r\n\r\n    function js_searchData() {\r\n        var _search = $('#txtSearchBox').val()\r\n        if (_search == \"\" || _search == null || _search == undefined) {\r\n            alert(\"Please fill the Search Box \");\r\n            return false;\r\n        }\r\n        else {\r\n            $.ajax({\r\n                type: 'POST',\r\n                url: '/WebCMS/SearchDataShow',\r\n                data: { Param: _search },\r\n                async: false,\r\n                dataType: 'json',\r\n                success: function (data) {\r\n                    var _Html='';\r\n                    if (data.length > 0) {\r\n                        for (var P = 0; P < data.length; P++) {\r\n\r\n                            _Html += '<tr><td>' + data[P].PageName + '</td>';\r\n                            if (data[P].AddBy == 0) {\r\n                                _Html += '<td><a href=\"' + data[P].PageId + '\" title=\"Read more - ' + data[P].PageName + '\"  target=\"_blank\" rel=\"noopener noreferrer\"><i class=\"fa fa-eye\"></i></a></td>';\r\n                            }\r\n                            else if (data[P].AddBy == 1) {\r\n                                _Html += '<td><a href=\"../Website/' + data[P].MetaDescription +'/CONTENTFILES/' + data[P].HtmlContent + '\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"Read more - ' + data[P].PageName + '\"><i class=\"fa fa-eye\"></i></a></td>';\r\n                            }\r\n\r\n                            _Html += '</tr>';\r\n                        }\r\n                        $('#ResultSearchData').html(_Html);\r\n                        $('#SearchResults').modal('show');\r\n                    }\r\n                    else {\r\n                        alert(\"No Record Found!!\");\r\n                    }\r\n                    $('#txtSearchBox').val('');\r\n\r\n                    //$.each(data, function (key, value) {\r\n                    //    $('#ddlWebsiteList')\r\n                    //        .append($(\"<option></option>\")\r\n            