n: relative;\r\n    overflow: hidden;\r\n}\r\n\r\n.galleryItems2 .galleryBoxItem:nth-child(1),\r\n.galleryItems2 .galleryBoxItem:nth-child(2) {\r\n    width: 50%;\r\n    float: left;\r\n}\r\n\r\n.VideoGallery p{  font-size: 16px;}\r\n\r\n.galleryContent {\r\n    background: linear-gradient(180deg, transparent, var(--ColorBlue));\r\n    width: 100%;\r\n    height: 100%;\r\n    position: absolute;\r\n    bottom: -100%;\r\n    left: 0px;\r\n    display: flex;\r\n    justify-content: flex-end;\r\n    align-items: center;\r\n    flex-direction: column;\r\n    padding-bottom: 15px;\r\n    transition: all .2s;\r\n    text-align: center;\r\n}\r\n\r\n.galleryBoxItem:hover .galleryContent {\r\n    bottom: 0px !important;\r\n}\r\n\r\n.photoGallery h2 { font-size: 50px; font-weight: 200;}\r\n.photoGallery p { font-size: 16px;} \r\n/*VideoGallery section end*/\r\n/*News section Start*/\r\n.newsArrow {\r\n    background: var(--orange);\r\n    height: 40px;\r\n    position: relative;\r\n    width: calc(100% - 20px);\r\n}\r\n\r\n.newsArrow::after {\r\n    position: absolute;\r\n    right: -20px;\r\n    top: 0px;\r\n    content: '';\r\n    width: 0px;\r\n    height: 0px;\r\n    border-top: 20px solid transparent;\r\n    border-bottom: 20px solid transparent;\r\n    border-left: 20px solid var(--orange);\r\n}\r\n\r\n\r\n.f-600 {\r\n    font-weight: 600;\r\n}\r\n\r\n.customNavOwl button {\r\n    border-radius: 100%;\r\n    border: solid 1px #fff;\r\n    outline: none;\r\n    background: none;\r\n    color: #fff;\r\n    width: 48px;\r\n    height: 48px;\r\n    cursor: pointer;\r\n    color: var(--dark-orange);\r\n    border: solid 1px var(--dark-orange);\r\n}\r\n\r\n.customNavOwl button.owl-prev {\r\n    margin-right: 5px;\r\n}\r\n\r\n/*News section End*/\r\n.subscribe {\r\n    background: var(--darkBlue);\r\n    position: relative;\r\n}\r\n\r\n.subscribe::before {\r\n    position: absolute;\r\n    height: 80px;\r\n    top: -79px;\r\n    background: var(--darkBlue);\r\n    content: '';