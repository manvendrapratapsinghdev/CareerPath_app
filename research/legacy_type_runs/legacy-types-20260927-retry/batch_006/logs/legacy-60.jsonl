r.js?v=1.x\"></script>\n<script src=\"/themes/iai/js/general.js?v=1.x\"></script>\n<script src=\"/themes/iai/js/custom.js?v=1.x\"></script>\n<script src=\"/themes/iai/js/jquery.easy-ticker.min.js?v=1.x\"></script>\n<script src=\"/themes/iai/js/bootstrap-4.2.1.js?v=1.x\"></script>\n<script src=\"/themes/iai/js/owl.carousel.min.js?v=1.x\"></script>\n<script src=\"/themes/iai/js/wow.min.js?v=1.x\"></script>\n\n\t<link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap\" rel=\"stylesheet\">\n\n  \n\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=AW-16517835028\"> </script>\n <script>\n  window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'AW-16517835028');\n</script>\n  </head>\n  <body class=\"noJS\">\n       <!-- <a href=\"#main-content\" class=\"visually-hidden focusable\">\n      Skip to main content\n    </a>-->\n    \n      <div class=\"dialog-off-canvas-main-canvas\" data-off-canvas-main-canvas>\n    \n<style>.iai-notification {\n    width: 100%;\n    background: #f7f9fc;\n    border-bottom: 1px solid #e1e8f0;\n    border-top: 1px solid #e1e8f0;\n}\n\n.iai-notification .container-fluid {\n    width: 100%;\n}\n\n.iai-ticker {\n    display: flex;\n    align-items: center;\n    width: 100%;\n    height: 48px;\n    overflow: hidden;\n}\n\n/* ==========================================\n   ANNOUNCEMENT TITLE\n========================================== */\n\n.iai-title {\n    flex: 0 0 auto;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 0 20px;\n    background: var(--iai-navy);\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n    white-space: nowrap;\n    position: relative;\n    z-index: 2;\n}\n\n.iai-title i {\n    color: var(--iai-orange);\n    font-size: 16px;\n}\n\n\n/* ==========================================\n   MARQUEE AREA\n========================================== */\n\n.iai-marquee {\n    flex: 1;\n    min-width: 0;\n    padding-left: 10px;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    overflow: hidden;\n    position: relative;\n    background: #fff;\n}\n\n\n/* ==========================================\n   SCROLLING TRACK\n========================================== */\n\n.iai-track {\n    display: inline-flex;\n    align-items: center;\n    width: max-content;\n    white-space: nowrap;\n\n    animation: iaiTicker 30s linear infinite;\n}\n\n/* Pause when mouse is over ticker */\n.iai-marquee:hover .iai-track {\n    animation-play-state: paused;\n}\n\n\n/* ==========================================\n   DRUPAL CONTENT\n========================================== */\n\n.iai-track a {\n    display: inline-block;\n    margin-right: 50px;\n    color: var(--iai-blue);\n    font-size: 14px;\n    font-weight: 600;\n    text-decoration: none;\n    white-space: nowrap;\n}\n\n.iai-track a:hover {\n    color: var(--iai-orange);\n}\n\n\n/* ==========================================\n   TICKER ANIMATION\n========================================== */\n\n@keyframes iaiTicker {\n    0% {\n        transform: translateX(100%);\n    }\n\n    100% {\n        transform: translateX(-100%);\n    }\n}\n\n\n/* ==========================================\n   VIEW ALL\n========================================== */\n\n.iai-view {\n    flex: 0 0 auto;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    padding: 0 15px;\n    background: #fff;\n    border-left: 1px solid #e1e8f0;\n    position: relative;\n    z-index: 2;\n}\n\n.iai-view a {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    color: var(--iai-navy);\n    font-size: 13px;\n    font-weight: 700;\n    white-space: nowrap;\n    text-decoration: none;\n}\n\n.iai-view a:hover {\n    color: var(--iai-orange);\n}\n\n.iai-view i {\n    font-size: 11px;\n    transition: transform .2s ease;\n}\n\n.iai-view a:hover i {\n    transform: translateX(3px);\n}\n\n\n/* ==========================================\n   MOBILE\n========================================== */\n\n@media (max-width: 767px) {\n\n    .iai-notification .container-fluid {\n        padding: 0;\n    }\n\n    .iai-ticker {\n        height: 44px;\n    }\n\n    .iai-title {\n        padding: 0 12px;\n        font-size: 12px;\n    }\n\n    .iai-title span {\n        display: none;\n    }\n\n    .iai-title i {\n        font-size: 15px;\n    }\n\n    .iai-track a {\n        font-size: 13px;\n        margin-right: 35px;\n    }\n\n    .iai-view {\n        padding: 0 10px;\n    }\n\n    .iai-view a {\n        font-size: 12px;\n    }\n\n    .iai-view i {\n        display: none;\n    }\n}\n\n\n/* ==========================================\n   REDUCED MOTION\n========================================== */\n\n@media (prefers-reduced-motion: reduce) {\n\n    .iai-track {\n        animation: none;\n    }\n\n}\n\n\n/* Placement Section */\n.placement-section{\n    background:#fff;\n    padding:40px 0 60px;\n    font-family:'Poppins', sans-serif;\n}\n\n/* Main Heading */\n.placement-title{\n    text-align:center;\n    color:#071a36;\n    font-size:26px;\n    font-weight:700;\n    margin:0 0 35px;\n}\n\n.placement-title span{\n    color:#c41230;\n}\n\n/* Items */\n.placement-row{\n    align-items:center;\n}\n\n.placement-item{\n    position:relative;\n    text-align:center;\n    padding:0 20px;\n}\n\n/* Divider */\n.placement-item:not(:last-child)::after{\n    content:\"\";\n    position:absolute;\n    top:0;\n    right:0;\n    width:1px;\n    height:125px;\n    background:#d9e2ec;\n}\n\n/* Small Icon Box */\n.placement-icon{\n    width:55px;\n    height:55px;\n    margin:0 auto 12px;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    background:#f0eefb;\n    border-radius:7px;\n}\n\n.placement-icon img{\n    width:36px;\n    height:36px;\n    object-fit:contain;\n}\n\n/* Number */\n.placement-item h3{\n    color:#071a36;\n    font-size:23px;\n    line-height:1.2;\n    font-weight:700;\n    margin:0 0 6px;\n}\n\n/* Description */\n.placement-item p{\n    color:#07101f;\n    font-size:14px;\n    line-height:1.5;\n    margin:0;\n}\n\n/* Mobile */\n@media (max-width:767px){\n\n    .placement-title{\n        font-size:22px;\n        margin-bottom:20px;\n    }\n\n    .placement-item{\n        padding:22px 15px;\n    }\n\n    .placement-item:not(:last-child)::after{\n        display:none;\n    }\n\n    .placement-item:not(:last-child){\n        border-bottom:1px solid #d9e2ec;\n    }\n\n    .placement-icon{\n        width:50px;\n        height:50px;\n    }\n\n    .placement-icon img{\n        width:32px;\n        height:32px;\n    }\n\n    .placement-item h3{\n        font-size:20px;\n    }\n\n    .placement-item p{\n        font-size:13px;\n    }\n}\n</style>\t\n\t\n\t<div id=\"wrapper\">\n\t\t<!--<div class=\"preloader\">\n\t\t\t<div class=\"spinner\"></div>\n\t\t</div>-->\n\n\n\t\t  <!-- <style>\n  .gca_button {\n  -webkit-border-radius: 30px;\n  border-radius: 30px;\ncolor: #333333 !important;\n    cursor: pointer;\n    display: inline-block;\n    font-size: 15px !important;\n    padding: 5px 10px !important;\n\n  text-align: center;\n  text-decoration: none;\n  text-trcurl: (23) Failure writing output to destination, passed 8186 returned 0\n","exit_code":0,"status":"completed"}}
